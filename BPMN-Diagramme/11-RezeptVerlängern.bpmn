<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_11" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_11">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Arzt" name="Arzt" processRef="Process_Arzt" />
    <bpmn:participant id="Pool_Apotheke" name="Apotheke" processRef="Process_Apotheke" />
    <bpmn:messageFlow id="MF_01" name="Folgerezeptanfrage" sourceRef="Task_P_Anfordern" targetRef="Start_System" />
    <bpmn:messageFlow id="MF_02" name="Anfrage zur Prüfung" sourceRef="Task_S_AnArztWeiterleiten" targetRef="Start_Arzt" />
    <bpmn:messageFlow id="MF_03" name="Arztentscheidung" sourceRef="Task_Arzt_Entscheiden" targetRef="Task_S_EntscheidungVerarbeiten" />
    <bpmn:messageFlow id="MF_04" name="Digitales Rezept" sourceRef="Task_S_RezeptSenden" targetRef="Task_P_RezeptErhalten" />
    <bpmn:messageFlow id="MF_05" name="Rezept zur Einlösung" sourceRef="Task_S_RezeptSenden" targetRef="Start_Apotheke" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:dataObjectReference id="DataObject_Notiz" name="Patientennotiz" dataObjectRef="DO_Notiz" />
    <bpmn:dataObject id="DO_Notiz" />
    <bpmn:startEvent id="Start_Patient" name="Folgerezept benötigt">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_P_Anfordern" name="Folgerezept für Medikament anfordern">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
      <bpmn:property id="Prop_P_Notiz" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_P1">
        <bpmn:sourceRef>DataObject_Notiz</bpmn:sourceRef>
        <bpmn:targetRef>Prop_P_Notiz</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_P_Anfordern" targetRef="Task_P_RezeptErhalten" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_P_RezeptErhalten" targetRef="End_Patient" />
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Patient" targetRef="Task_P_Anfordern" />
    <bpmn:userTask id="Task_P_RezeptErhalten" name="Digitales Rezept empfangen und speichern">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Patient" name="Folgerezept erhalten">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Folgerezept-anfrage empfangen">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_S" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Task_S_AnfragePruefen" name="Anfrage prüfen&#10;(Intervall und Historie)">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      <bpmn:property id="Prop_S_Rez" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S1">
        <bpmn:sourceRef>DataStore_Rezepte</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Rez</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:subProcess>
    <bpmn:sendTask id="Task_S_AnArztWeiterleiten" name="Anfrage an Arzt weiterleiten">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_S_EntscheidungVerarbeiten" name="Arztentscheidung verarbeiten und Rezept erstellen">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
      <bpmn:property id="Property_1r0q8bz" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0xqsqnl">
        <bpmn:sourceRef>DataStoreReference_1kdnmyx</bpmn:sourceRef>
        <bpmn:targetRef>Property_1r0q8bz</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_S_RezeptSenden" name="Rezept an Patient und Apotheke senden">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_System" targetRef="Task_S_AnfragePruefen" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_S_AnfragePruefen" targetRef="Task_S_AnArztWeiterleiten" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_S_AnArztWeiterleiten" targetRef="Task_S_EntscheidungVerarbeiten" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_S_EntscheidungVerarbeiten" targetRef="Task_S_RezeptSenden" />
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_S_RezeptSenden" targetRef="End_System" />
    <bpmn:dataStoreReference id="DataStoreReference_1kdnmyx" name="Rezeptdatenbank" />
    <bpmn:dataStoreReference id="DataStore_Rezepte" name="Rezeptdatenbank" />
    <bpmn:endEvent id="End_System" name="Folgerezept ausgestellt">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Arzt" isExecutable="false">
    <bpmn:startEvent id="Start_Arzt" name="Prüfauftrag erhalten">
      <bpmn:outgoing>Flow_Ar1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Ar" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Arzt_Pruefen" name="Patientenakte und Medikamentenhistorie pruefen">
      <bpmn:incoming>Flow_Ar1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ar2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Arzt_Entscheiden" name="Rezept genehmigen und digital signieren">
      <bpmn:incoming>Flow_Ar2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ar3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Ar1">
        <bpmn:targetRef>DataObject_SigniertesRezept</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Ar1" sourceRef="Start_Arzt" targetRef="Task_Arzt_Pruefen" />
    <bpmn:sequenceFlow id="Flow_Ar2" sourceRef="Task_Arzt_Pruefen" targetRef="Task_Arzt_Entscheiden" />
    <bpmn:sequenceFlow id="Flow_Ar3" sourceRef="Task_Arzt_Entscheiden" targetRef="End_Arzt" />
    <bpmn:dataObjectReference id="DataObject_SigniertesRezept" name="Signiertes Rezept" dataObjectRef="DO_SigRezept" />
    <bpmn:dataObject id="DO_SigRezept" />
    <bpmn:endEvent id="End_Arzt" name="Entscheidung getroffen">
      <bpmn:incoming>Flow_Ar3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Apotheke" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_Ap3" sourceRef="Task_Ap_Reservieren" targetRef="End_Apotheke" />
    <bpmn:sequenceFlow id="Flow_Ap2" sourceRef="Task_Ap_Pruefen" targetRef="Task_Ap_Reservieren" />
    <bpmn:sequenceFlow id="Flow_Ap1" sourceRef="Start_Apotheke" targetRef="Task_Ap_Pruefen" />
    <bpmn:endEvent id="End_Apotheke" name="Medikament bereit">
      <bpmn:incoming>Flow_Ap3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Ap_Reservieren" name="Medikament reservieren und Abholung melden">
      <bpmn:incoming>Flow_Ap2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ap3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ap_Pruefen" name="Rezept prüfen und Medikament bereitstellen">
      <bpmn:incoming>Flow_Ap1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ap2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Apotheke" name="Rezept zur Einlösung erhalten">
      <bpmn:outgoing>Flow_Ap1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Ap" />
    </bpmn:startEvent>
  </bpmn:process>
