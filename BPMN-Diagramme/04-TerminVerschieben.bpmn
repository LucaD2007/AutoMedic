    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Pr01" sourceRef="Start_Praxis" targetRef="Task_Pr1" />
    <bpmn:sequenceFlow id="Flow_Pr02" sourceRef="Task_Pr1" targetRef="End_Praxis" />
