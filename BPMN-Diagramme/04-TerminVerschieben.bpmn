<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_04" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collab_04">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Proc_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Proc_System" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Proc_Praxis" />
    <bpmn:messageFlow id="MF_01" name="Verschiebungsanfrage" sourceRef="Task_P1" targetRef="Start_System" />
    <bpmn:messageFlow id="MF_02" name="Alternative Termine" sourceRef="Task_S3" targetRef="Task_P2" />
    <bpmn:messageFlow id="MF_03" name="Terminauswahl" sourceRef="Task_P2" targetRef="Task_S4" />
    <bpmn:messageFlow id="MF_04" name="Verschiebungsbestätigung" sourceRef="Task_S5" targetRef="IMCatch_Bestaetigung" />
    <bpmn:messageFlow id="MF_05" name="Änderungsbenachrichtigung" sourceRef="Task_S5" targetRef="Start_Praxis" />
    <bpmn:messageFlow id="MF_06" sourceRef="Task_S2" targetRef="Task_P3" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Patient" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_P01" sourceRef="Start_Patient" targetRef="Task_P1" />
    <bpmn:sequenceFlow id="Flow_P02" sourceRef="Task_P1" targetRef="GW_P_Split" />
    <bpmn:sequenceFlow id="Flow_P03_Ja" name="Ja" sourceRef="GW_P_Split" targetRef="Task_P2" />
    <bpmn:sequenceFlow id="Flow_P03_Nein" name="Nein" sourceRef="GW_P_Split" targetRef="Task_P3" />
    <bpmn:sequenceFlow id="Flow_P04" sourceRef="Task_P2" targetRef="IMCatch_Bestaetigung" />
    <bpmn:sequenceFlow id="Flow_P05_Ja" sourceRef="IMCatch_Bestaetigung" targetRef="GW_P_Merge" />
    <bpmn:sequenceFlow id="Flow_P05_Nein" sourceRef="Task_P3" targetRef="GW_P_Merge" />
    <bpmn:sequenceFlow id="Flow_P06" sourceRef="GW_P_Merge" targetRef="End_Patient" />
    <bpmn:endEvent id="End_Patient" name="Prozess&#10;abgeschlossen">
      <bpmn:incoming>Flow_P06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_P_Merge" name="">
      <bpmn:incoming>Flow_P05_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_P05_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_P06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="IMCatch_Bestaetigung" name="Bestätigung&#10;erhalten">
      <bpmn:incoming>Flow_P04</bpmn:incoming>
      <bpmn:outgoing>Flow_P05_Ja</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Bestaetigung" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_P2" name="Neuen Termin auswaehlen&#10;und bestätigen">
      <bpmn:incoming>Flow_P03_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_P04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_P_Split" name="Verschiebung&#10;möglich?">
      <bpmn:incoming>Flow_P02</bpmn:incoming>
      <bpmn:outgoing>Flow_P03_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_P03_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_P1" name="Termin auswaehlen und&#10;Verschiebungsanfrage stellen">
      <bpmn:incoming>Flow_P01</bpmn:incoming>
      <bpmn:outgoing>Flow_P02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_P1">
        <bpmn:targetRef>DO_Anfrage_Ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Patient" name="Termin verschieben&#10;gewuenscht">
      <bpmn:outgoing>Flow_P01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:dataObjectReference id="DO_Anfrage_Ref" name="Verschiebungsanfrage" dataObjectRef="DO_Anfrage" />
    <bpmn:dataObject id="DO_Anfrage" />
    <bpmn:receiveTask id="Task_P3" name="Ablehnungshinweis&#10;erhalten">
      <bpmn:incoming>Flow_P03_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_P05_Nein</bpmn:outgoing>
    </bpmn:receiveTask>
  </bpmn:process>
  <bpmn:process id="Proc_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Verschiebungsanfrage&#10;eingegangen">
      <bpmn:outgoing>Flow_S01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartSys" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_S_Split" name="Verschiebung innerhalb&#10;der Frist?">
      <bpmn:incoming>Flow_S02</bpmn:incoming>
      <bpmn:outgoing>Flow_S03_Nein</bpmn:outgoing>
      <bpmn:outgoing>Flow_S03_Ja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_S01" sourceRef="Start_System" targetRef="Task_S1" />
    <bpmn:sequenceFlow id="Flow_S02" sourceRef="Task_S1" targetRef="GW_S_Split" />
    <bpmn:sequenceFlow id="Flow_S03_Nein" name="Nein" sourceRef="GW_S_Split" targetRef="Task_S2" />
    <bpmn:sequenceFlow id="Flow_S03_Ja" name="Ja" sourceRef="GW_S_Split" targetRef="Task_S3" />
    <bpmn:sequenceFlow id="Flow_S04_Nein" sourceRef="Task_S2" targetRef="End_Abbruch" />
    <bpmn:sequenceFlow id="Flow_S04_Ja" sourceRef="Task_S3" targetRef="Task_S4" />
    <bpmn:sequenceFlow id="Flow_S07" sourceRef="Task_S5" targetRef="End_System" />
    <bpmn:serviceTask id="Task_S1" name="Anfrage prüfen und&#10;Alternativen ermitteln">
      <bpmn:incoming>Flow_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_S3" name="Alternative Termine&#10;an Patient senden">
      <bpmn:incoming>Flow_S03_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S04_Ja</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_System" name="Verschiebung&#10;abgeschlossen">
      <bpmn:incoming>Flow_S07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_S5" name="Bestätigung und&#10;Benachrichtigung&#10;versenden">
      <bpmn:incoming>Flow_S06</bpmn:incoming>
      <bpmn:outgoing>Flow_S07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Abbruch" name="Verschiebung&#10;abgelehnt">
      <bpmn:incoming>Flow_S04_Nein</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_S2" name="Ablehnungshinweis an&#10;Patient senden">
      <bpmn:incoming>Flow_S03_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_S04_Nein</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_S4" name="Terminauswahl&#10;empfangen">
      <bpmn:incoming>Flow_S04_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S05</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_S06" sourceRef="SubProc_S" targetRef="Task_S5" />
    <bpmn:sequenceFlow id="Flow_S05" sourceRef="Task_S4" targetRef="SubProc_S" />
    <bpmn:dataStoreReference id="DS_Terminkalender" name="Terminkalender" />
    <bpmn:serviceTask id="SubProc_S" name="Terminverschiebung&#10;verarbeiten">
      <bpmn:incoming>Flow_S05</bpmn:incoming>
      <bpmn:outgoing>Flow_S06</bpmn:outgoing>
      <bpmn:property id="Property_1xrmzg4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Sub">
        <bpmn:sourceRef>DS_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Property_1xrmzg4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Sub">
        <bpmn:targetRef>DS_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
  </bpmn:process>
