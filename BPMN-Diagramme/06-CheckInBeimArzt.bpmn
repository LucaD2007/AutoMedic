<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_6" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collaboration_06">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Process_Praxis" />
    <bpmn:messageFlow id="MF_01" name="Check-In-Daten" sourceRef="Task_P_CheckIn" targetRef="Start_System" />
    <bpmn:messageFlow id="MF_02" name="Wartenummer und Wartezeit" sourceRef="Task_S_AnwesendMarkieren" targetRef="Task_P_WartenummerErhalten" />
    <bpmn:messageFlow id="MF_03" name="Ankunftsbenachrichtigung" sourceRef="Task_S_PraxisBenachrichtigen" targetRef="Start_Praxis" />
    <bpmn:messageFlow id="MF_04" name="Aufruf-Signal" sourceRef="Task_Pr_PatientAufrufen" targetRef="Task_S_AufrufWeiterleiten" />
    <bpmn:messageFlow id="MF_05" name="Aufruf" sourceRef="Task_S_AufrufWeiterleiten" targetRef="Task_P_AufrufErhalten" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="In Praxis eingetroffen">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_P_WartenummerErhalten" name="Wartenummer und Wartezeit erhalten">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_P_AufrufErhalten" name="Aufruf erhalten und zum Behandlungszimmer gehen">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Patient" name="Check-In abgeschlossen">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObject_Versichertenkarte" name="Versichertenkarte" dataObjectRef="DO_Karte" />
    <bpmn:dataObject id="DO_Karte" />
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Patient" targetRef="Task_P_CheckIn" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_P_CheckIn" targetRef="Task_P_WartenummerErhalten" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_P_WartenummerErhalten" targetRef="Task_P_AufrufErhalten" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_P_AufrufErhalten" targetRef="End_Patient" />
    <bpmn:manualTask id="Task_P_CheckIn" name="Check-In starten und Versichertenkarte einlesen">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
      <bpmn:property id="Property_0tfvysu" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_P1">
        <bpmn:sourceRef>DataObject_Versichertenkarte</bpmn:sourceRef>
        <bpmn:targetRef>Property_0tfvysu</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Check-In-Daten empfangen">
      <bpmn:outgoing>Flow_0mngkrk</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_S" />
    </bpmn:startEvent>
    <bpmn:task id="Task_S_AnwesendMarkieren" name="Patient als anwesend registrieren und Wartenummer vergeben">
      <bpmn:incoming>Flow_1dsb6l8</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_S_PraxisBenachrichtigen" name="Praxis über Ankunft benachrichtigen">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_S_AufrufWeiterleiten" name="Aufruf an Patient weiterleiten">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="End_System" name="Check-In verarbeitet">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_S_AnwesendMarkieren" targetRef="Task_S_PraxisBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_S_PraxisBenachrichtigen" targetRef="Task_S_AufrufWeiterleiten" />
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_S_AufrufWeiterleiten" targetRef="End_System" />
    <bpmn:serviceTask id="Activity_1v2hf2s" name="Check-In-Daten validieren">
      <bpmn:incoming>Flow_0mngkrk</bpmn:incoming>
      <bpmn:outgoing>Flow_1dsb6l8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0mngkrk" sourceRef="Start_System" targetRef="Activity_1v2hf2s" />
    <bpmn:sequenceFlow id="Flow_1dsb6l8" sourceRef="Activity_1v2hf2s" targetRef="Task_S_AnwesendMarkieren" />
  </bpmn:process>
  <bpmn:process id="Process_Praxis" isExecutable="false">
    <bpmn:startEvent id="Start_Praxis" name="Ankunftsbenachrichtigung erhalten">
      <bpmn:outgoing>Flow_Pr1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Pr" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Pr_AnkunftPruefen" name="Patientendaten und Termingrund einsehen">
      <bpmn:incoming>Flow_Pr1</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Pr_ReihenfolgeFestlegen" name="Behandlungsreihenfolge festlegen">
      <bpmn:incoming>Flow_Pr2</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_Pr_PatientAufrufen" name="Patient aufrufen">
      <bpmn:incoming>Flow_Pr3</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Praxis" name="Patient aufgerufen">
      <bpmn:incoming>Flow_Pr4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Pr1" sourceRef="Start_Praxis" targetRef="Task_Pr_AnkunftPruefen" />
    <bpmn:sequenceFlow id="Flow_Pr2" sourceRef="Task_Pr_AnkunftPruefen" targetRef="Task_Pr_ReihenfolgeFestlegen" />
    <bpmn:sequenceFlow id="Flow_Pr3" sourceRef="Task_Pr_ReihenfolgeFestlegen" targetRef="Task_Pr_PatientAufrufen" />
    <bpmn:sequenceFlow id="Flow_Pr4" sourceRef="Task_Pr_PatientAufrufen" targetRef="End_Praxis" />
  </bpmn:process>
