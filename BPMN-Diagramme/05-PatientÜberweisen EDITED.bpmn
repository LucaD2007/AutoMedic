    <bpmn:userTask id="Task_F_Pruefen" name="Überweisungsdaten und Diagnose prüfen">
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_F_Bestaetigen" name="Patientenakte anlegen">
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_F1">
        <bpmn:targetRef>DataObject_Patientenakte</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Facharzt" name="Vorbereitung abgeschlossen">
      <bpmn:incoming>Flow_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObject_Patientenakte" name="Patientenakte" dataObjectRef="DO_Patientenakte" />
    <bpmn:dataObject id="DO_Patientenakte" />
    <bpmn:startEvent id="Start_Facharzt" name="Überweisungsdaten und Termin erhalten">
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_F" />
    </bpmn:startEvent>
  </bpmn:process>
