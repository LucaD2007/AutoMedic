  <bpmn:collaboration id="Collaboration_05">
    <bpmn:participant id="Pool_Arzt" name="Hausarzt" processRef="Process_Arzt" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_Facharzt" name="Facharzt" processRef="Process_Facharzt" />
    <bpmn:messageFlow id="MF_01" name="Überweisung" sourceRef="Task_A_Erstellen" targetRef="Start_System" />
    <bpmn:messageFlow id="MF_02" name="Überweisungshinweis und Terminvorschläge" sourceRef="Task_S_Vorschlaege" targetRef="Start_Patient" />
    <bpmn:messageFlow id="MF_03" name="Terminwunsch" sourceRef="Task_P_Waehlen" targetRef="Task_S_Vermittlung" />
    <bpmn:messageFlow id="MF_04" name="Buchungsbestätigung" sourceRef="Task_S_Benachrichtigen" targetRef="Task_P_Bestaetigung" />
    <bpmn:messageFlow id="MF_05" name="Überweisungs-daten und Termin" sourceRef="Task_S_Benachrichtigen" targetRef="Start_Facharzt" />
    <bpmn:messageFlow id="MF_06" name="Statusrückmeldung" sourceRef="Task_S_Benachrichtigen" targetRef="Task_A_Status" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Arzt" isExecutable="false">
    <bpmn:startEvent id="Start_Arzt" name="Überweisungsbedarf festgestellt">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_A_Erstellen" name="Überweisung erstellen und im System erfassen">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_A1">
        <bpmn:targetRef>DataObject_Ueberweisung</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_A_Status" name="Statusrückmeldung erhalten">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Arzt" name="Überweisung abgeschlossen">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObject_Ueberweisung" name="Überweisungsschein" dataObjectRef="DO_Ueberweisung" />
    <bpmn:dataObject id="DO_Ueberweisung" />
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Start_Arzt" targetRef="Task_A_Erstellen" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_A_Erstellen" targetRef="Task_A_Status" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_A_Status" targetRef="End_Arzt" />
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Überweisung empfangen">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_S" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_S_Vorschlaege" name="Terminvorschläge an Patient senden">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_S_Benachrichtigen" name="Patient, Facharzt und Hausarzt benachrichtigen">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_System" name="Überweisung vermittelt">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_1typ51x" name="Überweisungs-datenbank" />
    <bpmn:dataStoreReference id="DataStore_Terminkalender" name="Terminkalender" />
    <bpmn:dataStoreReference id="DataStore_Ueberweisungen" name="Überweisungs-datenbank" />
    <bpmn:subProcess id="Task_S_Ermitteln" name="Passenden Facharzt und Termine ermitteln">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      <bpmn:property id="Prop_S_Kal" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S1">
        <bpmn:sourceRef>DataStore_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_0tfs9bn">
        <bpmn:sourceRef>DataStoreReference_1typ51x</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:subProcess>
    <bpmn:subProcess id="Task_S_Vermittlung" name="Termin buchen und mit Überweisung verknüpfen">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
      <bpmn:property id="Property_1heslz0" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0d73s9m">
        <bpmn:sourceRef>DataStore_Ueberweisungen</bpmn:sourceRef>
        <bpmn:targetRef>Property_1heslz0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_System" targetRef="Task_S_Ermitteln" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_S_Ermitteln" targetRef="Task_S_Vorschlaege" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_S_Vorschlaege" targetRef="Task_S_Vermittlung" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_S_Vermittlung" targetRef="Task_S_Benachrichtigen" />
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_S_Benachrichtigen" targetRef="End_System" />
  </bpmn:process>
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Überweisungs-hinweis erhalten">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_P" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_P_Einsehen" name="Überweisung und Terminvorschläge einsehen">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_P_Waehlen" name="Termin auswählen und bestätigen">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_P_Bestaetigung" name="Buchungsbestätigung erhalten">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Patient" name="Facharzttermin gebucht">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Patient" targetRef="Task_P_Einsehen" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_P_Einsehen" targetRef="Task_P_Waehlen" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_P_Waehlen" targetRef="Task_P_Bestaetigung" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_P_Bestaetigung" targetRef="End_Patient" />
  </bpmn:process>
  <bpmn:process id="Process_Facharzt" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Start_Facharzt" targetRef="Task_F_Pruefen" />
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_F_Pruefen" targetRef="Task_F_Bestaetigen" />
