<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_5"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="EKX DeepAgent"
                  exporterVersion="1.0">

  <!-- ====== COLLABORATION ====== -->
  <bpmn:collaboration id="Collaboration_05">
    <bpmn:participant id="Pool_Arzt" name="Hausarzt" processRef="Process_Arzt" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_Facharzt" name="Facharzt" processRef="Process_Facharzt" />

    <bpmn:messageFlow id="MF_01" name="Ueberweisung erfassen" sourceRef="Task_A_ImSystemErfassen" targetRef="Task_S_UeberweisungEmpfangen" />
    <bpmn:messageFlow id="MF_02" name="Ueberweisungshinweis" sourceRef="Task_S_PatientBenachrichtigen" targetRef="Start_Patient" />
    <bpmn:messageFlow id="MF_03" name="Terminvorschlaege" sourceRef="Task_S_TerminvorschlaegeAnPatient" targetRef="Task_P_VorschlaegeErhalten" />
    <bpmn:messageFlow id="MF_04" name="Terminwunsch" sourceRef="Task_P_TerminWaehlen" targetRef="Task_S_TerminwunschEmpfangen" />
    <bpmn:messageFlow id="MF_05" name="Buchungsbestaetigung" sourceRef="Task_S_BestaetigungAnPatient" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:messageFlow id="MF_06" name="Ueberweisungsdaten und Termin" sourceRef="Task_S_FacharztBenachrichtigen" targetRef="Start_Facharzt" />
    <bpmn:messageFlow id="MF_07" name="Statusrueckmeldung" sourceRef="Task_S_HausarztInformieren" targetRef="Task_A_StatusErhalten" />
  </bpmn:collaboration>

  <!-- ====== HAUSARZT PROCESS ====== -->
  <bpmn:process id="Process_Arzt" isExecutable="false">
    <bpmn:startEvent id="Start_Arzt" name="Ueberweisungsbedarf festgestellt">
      <bpmn:outgoing>Flow_A01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_A_DiagnoseErfassen" name="Diagnose und Fachrichtung dokumentieren">
      <bpmn:incoming>Flow_A01</bpmn:incoming>
      <bpmn:outgoing>Flow_A02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_A_Ueberweisung">
        <bpmn:targetRef>DataObject_Ueberweisung</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_A_UeberweisungErstellen" name="Ueberweisungsschein erstellen">
      <bpmn:incoming>Flow_A02</bpmn:incoming>
      <bpmn:outgoing>Flow_A03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_A_ImSystemErfassen" name="Ueberweisung im System erfassen">
      <bpmn:incoming>Flow_A03</bpmn:incoming>
      <bpmn:outgoing>Flow_A04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_A_StatusErhalten" name="Statusrueckmeldung erhalten">
      <bpmn:incoming>Flow_A04</bpmn:incoming>
      <bpmn:outgoing>Flow_A05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Arzt" name="Ueberweisung abgeschlossen">
      <bpmn:incoming>Flow_A05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObjectReference id="DataObject_Ueberweisung" name="Ueberweisungsschein" dataObjectRef="DO_Ueberweisung" />
    <bpmn:dataObject id="DO_Ueberweisung" />

    <bpmn:sequenceFlow id="Flow_A01" sourceRef="Start_Arzt" targetRef="Task_A_DiagnoseErfassen" />
    <bpmn:sequenceFlow id="Flow_A02" sourceRef="Task_A_DiagnoseErfassen" targetRef="Task_A_UeberweisungErstellen" />
    <bpmn:sequenceFlow id="Flow_A03" sourceRef="Task_A_UeberweisungErstellen" targetRef="Task_A_ImSystemErfassen" />
    <bpmn:sequenceFlow id="Flow_A04" sourceRef="Task_A_ImSystemErfassen" targetRef="Task_A_StatusErhalten" />
    <bpmn:sequenceFlow id="Flow_A05" sourceRef="Task_A_StatusErhalten" targetRef="End_Arzt" />
  </bpmn:process>

  <!-- ====== SYSTEM PROCESS ====== -->
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:task id="Task_S_UeberweisungEmpfangen" name="Ueberweisung empfangen und validieren">
      <bpmn:outgoing>Flow_S01</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_Store">
        <bpmn:targetRef>DataStore_Ueberweisungen</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_S_FacharztSuchen" name="Passende Fachaerzte im Umkreis suchen">
      <bpmn:incoming>Flow_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_S_Gefunden" name="Facharzt verfuegbar?">
      <bpmn:incoming>Flow_S02</bpmn:incoming>
      <bpmn:outgoing>Flow_S03_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_S03_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Pfad: kein Facharzt -->
    <bpmn:task id="Task_S_KeinFacharzt" name="Patient informieren: kein Facharzt verfuegbar">
      <bpmn:incoming>Flow_S03_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_S_EndNein</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_System_Nein" name="Keine Vermittlung moeglich">
      <bpmn:incoming>Flow_S_EndNein</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Pfad: Facharzt gefunden -->
    <bpmn:task id="Task_S_TermineLaden" name="Verfuegbare Termine beim Facharzt laden">
      <bpmn:incoming>Flow_S03_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S04</bpmn:outgoing>
      <bpmn:property id="Prop_S_Kal" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S_Kal">
        <bpmn:sourceRef>DataStore_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_S_PatientBenachrichtigen" name="Patient ueber Ueberweisung benachrichtigen">
      <bpmn:incoming>Flow_S04</bpmn:incoming>
      <bpmn:outgoing>Flow_S05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_TerminvorschlaegeAnPatient" name="Terminvorschlaege an Patient senden">
      <bpmn:incoming>Flow_S05</bpmn:incoming>
      <bpmn:outgoing>Flow_S06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_TerminwunschEmpfangen" name="Terminwunsch vom Patient empfangen">
      <bpmn:incoming>Flow_S06</bpmn:incoming>
      <bpmn:outgoing>Flow_S07</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_TerminBuchen" name="Termin beim Facharzt buchen">
      <bpmn:incoming>Flow_S07</bpmn:incoming>
      <bpmn:outgoing>Flow_S08</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_Kal">
        <bpmn:targetRef>DataStore_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_S_UeberweisungVerknuepfen" name="Ueberweisung mit Termin verknuepfen">
      <bpmn:incoming>Flow_S08</bpmn:incoming>
      <bpmn:outgoing>Flow_S09</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_Link">
        <bpmn:targetRef>DataStore_Ueberweisungen</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:parallelGateway id="GW_S_Parallel" name="">
      <bpmn:incoming>Flow_S09</bpmn:incoming>
      <bpmn:outgoing>Flow_S10a</bpmn:outgoing>
      <bpmn:outgoing>Flow_S10b</bpmn:outgoing>
      <bpmn:outgoing>Flow_S10c</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_S_BestaetigungAnPatient" name="Buchungsbestaetigung an Patient senden">
      <bpmn:incoming>Flow_S10a</bpmn:incoming>
      <bpmn:outgoing>Flow_S11a</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_FacharztBenachrichtigen" name="Facharzt ueber Ueberweisung und Termin informieren">
      <bpmn:incoming>Flow_S10b</bpmn:incoming>
      <bpmn:outgoing>Flow_S11b</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_HausarztInformieren" name="Hausarzt Statusrueckmeldung senden">
      <bpmn:incoming>Flow_S10c</bpmn:incoming>
      <bpmn:outgoing>Flow_S11c</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="GW_S_ParallelMerge" name="">
      <bpmn:incoming>Flow_S11a</bpmn:incoming>
      <bpmn:incoming>Flow_S11b</bpmn:incoming>
      <bpmn:incoming>Flow_S11c</bpmn:incoming>
      <bpmn:outgoing>Flow_S12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="End_System" name="Ueberweisung vermittelt">
      <bpmn:incoming>Flow_S12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Stores -->
    <bpmn:dataStoreReference id="DataStore_Terminkalender" name="Terminkalender" />
    <bpmn:dataStoreReference id="DataStore_Ueberweisungen" name="Ueberweisungsdatenbank" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_S01" sourceRef="Task_S_UeberweisungEmpfangen" targetRef="Task_S_FacharztSuchen" />
    <bpmn:sequenceFlow id="Flow_S02" sourceRef="Task_S_FacharztSuchen" targetRef="GW_S_Gefunden" />
    <bpmn:sequenceFlow id="Flow_S03_Ja" name="Ja" sourceRef="GW_S_Gefunden" targetRef="Task_S_TermineLaden" />
    <bpmn:sequenceFlow id="Flow_S03_Nein" name="Nein" sourceRef="GW_S_Gefunden" targetRef="Task_S_KeinFacharzt" />
    <bpmn:sequenceFlow id="Flow_S_EndNein" sourceRef="Task_S_KeinFacharzt" targetRef="End_System_Nein" />
    <bpmn:sequenceFlow id="Flow_S04" sourceRef="Task_S_TermineLaden" targetRef="Task_S_PatientBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_S05" sourceRef="Task_S_PatientBenachrichtigen" targetRef="Task_S_TerminvorschlaegeAnPatient" />
    <bpmn:sequenceFlow id="Flow_S06" sourceRef="Task_S_TerminvorschlaegeAnPatient" targetRef="Task_S_TerminwunschEmpfangen" />
    <bpmn:sequenceFlow id="Flow_S07" sourceRef="Task_S_TerminwunschEmpfangen" targetRef="Task_S_TerminBuchen" />
    <bpmn:sequenceFlow id="Flow_S08" sourceRef="Task_S_TerminBuchen" targetRef="Task_S_UeberweisungVerknuepfen" />
    <bpmn:sequenceFlow id="Flow_S09" sourceRef="Task_S_UeberweisungVerknuepfen" targetRef="GW_S_Parallel" />
    <bpmn:sequenceFlow id="Flow_S10a" sourceRef="GW_S_Parallel" targetRef="Task_S_BestaetigungAnPatient" />
    <bpmn:sequenceFlow id="Flow_S10b" sourceRef="GW_S_Parallel" targetRef="Task_S_FacharztBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_S10c" sourceRef="GW_S_Parallel" targetRef="Task_S_HausarztInformieren" />
    <bpmn:sequenceFlow id="Flow_S11a" sourceRef="Task_S_BestaetigungAnPatient" targetRef="GW_S_ParallelMerge" />
    <bpmn:sequenceFlow id="Flow_S11b" sourceRef="Task_S_FacharztBenachrichtigen" targetRef="GW_S_ParallelMerge" />
    <bpmn:sequenceFlow id="Flow_S11c" sourceRef="Task_S_HausarztInformieren" targetRef="GW_S_ParallelMerge" />
    <bpmn:sequenceFlow id="Flow_S12" sourceRef="GW_S_ParallelMerge" targetRef="End_System" />
  </bpmn:process>

  <!-- ====== PATIENT PROCESS ====== -->
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Ueberweisungshinweis erhalten">
      <bpmn:outgoing>Flow_P01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartP" />
    </bpmn:startEvent>

    <bpmn:task id="Task_P_UeberweisungEinsehen" name="Ueberweisung und Fachrichtung einsehen">
      <bpmn:incoming>Flow_P01</bpmn:incoming>
      <bpmn:outgoing>Flow_P02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_VorschlaegeErhalten" name="Terminvorschlaege einsehen">
      <bpmn:incoming>Flow_P02</bpmn:incoming>
      <bpmn:outgoing>Flow_P03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_TerminWaehlen" name="Termin auswaehlen und bestaetigen">
      <bpmn:incoming>Flow_P03</bpmn:incoming>
      <bpmn:outgoing>Flow_P04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_BestaetigungErhalten" name="Buchungsbestaetigung erhalten">
      <bpmn:incoming>Flow_P04</bpmn:incoming>
      <bpmn:outgoing>Flow_P05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Patient" name="Facharzttermin gebucht">
      <bpmn:incoming>Flow_P05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_P01" sourceRef="Start_Patient" targetRef="Task_P_UeberweisungEinsehen" />
    <bpmn:sequenceFlow id="Flow_P02" sourceRef="Task_P_UeberweisungEinsehen" targetRef="Task_P_VorschlaegeErhalten" />
    <bpmn:sequenceFlow id="Flow_P03" sourceRef="Task_P_VorschlaegeErhalten" targetRef="Task_P_TerminWaehlen" />
    <bpmn:sequenceFlow id="Flow_P04" sourceRef="Task_P_TerminWaehlen" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:sequenceFlow id="Flow_P05" sourceRef="Task_P_BestaetigungErhalten" targetRef="End_Patient" />
  </bpmn:process>

  <!-- ====== FACHARZT PROCESS ====== -->
  <bpmn:process id="Process_Facharzt" isExecutable="false">
    <bpmn:startEvent id="Start_Facharzt" name="Ueberweisungsdaten und Termin erhalten">
      <bpmn:outgoing>Flow_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartF" />
    </bpmn:startEvent>

    <bpmn:task id="Task_F_DatenPruefen" name="Ueberweisungsdaten und Diagnose pruefen">
      <bpmn:incoming>Flow_F01</bpmn:incoming>
      <bpmn:outgoing>Flow_F02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_F_PatientenakteAnlegen" name="Patientenakte anlegen oder aktualisieren">
      <bpmn:incoming>Flow_F02</bpmn:incoming>
      <bpmn:outgoing>Flow_F03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_F_Akte">
        <bpmn:targetRef>DataObject_Patientenakte</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_F_TerminBestaetigen" name="Termin im eigenen Kalender bestaetigen">
      <bpmn:incoming>Flow_F03</bpmn:incoming>
      <bpmn:outgoing>Flow_F04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Facharzt" name="Vorbereitung abgeschlossen">
      <bpmn:incoming>Flow_F04</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObjectReference id="DataObject_Patientenakte" name="Patientenakte" dataObjectRef="DO_Patientenakte" />
    <bpmn:dataObject id="DO_Patientenakte" />

    <bpmn:sequenceFlow id="Flow_F01" sourceRef="Start_Facharzt" targetRef="Task_F_DatenPruefen" />
    <bpmn:sequenceFlow id="Flow_F02" sourceRef="Task_F_DatenPruefen" targetRef="Task_F_PatientenakteAnlegen" />
    <bpmn:sequenceFlow id="Flow_F03" sourceRef="Task_F_PatientenakteAnlegen" targetRef="Task_F_TerminBestaetigen" />
    <bpmn:sequenceFlow id="Flow_F04" sourceRef="Task_F_TerminBestaetigen" targetRef="End_Facharzt" />
  </bpmn:process>

  <!-- ====== DIAGRAM ====== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_05">

      <!-- ===== HAUSARZT POOL ===== -->
      <bpmndi:BPMNShape id="Shape_Pool_Arzt" bpmnElement="Pool_Arzt" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1440" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Arzt" bpmnElement="Start_Arzt">
        <dc:Bounds x="232" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Diagnose" bpmnElement="Task_A_DiagnoseErfassen">
        <dc:Bounds x="320" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Ueberweisung" bpmnElement="Task_A_UeberweisungErstellen">
        <dc:Bounds x="470" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Erfassen" bpmnElement="Task_A_ImSystemErfassen">
        <dc:Bounds x="620" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Status" bpmnElement="Task_A_StatusErhalten">
        <dc:Bounds x="1330" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Arzt" bpmnElement="End_Arzt">
        <dc:Bounds x="1482" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DO_Ueberweisung" bpmnElement="DataObject_Ueberweisung">
        <dc:Bounds x="402" y="80" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="438" y="90" width="100" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_A01" bpmnElement="Flow_A01">
        <di:waypoint x="268" y="170" /><di:waypoint x="320" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A02" bpmnElement="Flow_A02">
        <di:waypoint x="420" y="170" /><di:waypoint x="470" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A03" bpmnElement="Flow_A03">
        <di:waypoint x="570" y="170" /><di:waypoint x="620" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A04" bpmnElement="Flow_A04">
        <di:waypoint x="720" y="170" /><di:waypoint x="1330" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A05" bpmnElement="Flow_A05">
        <di:waypoint x="1430" y="170" /><di:waypoint x="1482" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_Ueberweisung" bpmnElement="DOA_A_Ueberweisung">
        <di:waypoint x="380" y="130" /><di:waypoint x="410" y="130" />
      </bpmndi:BPMNEdge>

      <!-- ===== SYSTEM POOL ===== -->
      <bpmndi:BPMNShape id="Shape_Pool_System" bpmnElement="Pool_System" isHorizontal="true">
        <dc:Bounds x="160" y="340" width="1440" height="380" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_S_Empfangen" bpmnElement="Task_S_UeberweisungEmpfangen">
        <dc:Bounds x="250" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Suchen" bpmnElement="Task_S_FacharztSuchen">
        <dc:Bounds x="390" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Gefunden" bpmnElement="GW_S_Gefunden" isMarkerVisible="true">
        <dc:Bounds x="525" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="505" y="562" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_KeinFacharzt" bpmnElement="Task_S_KeinFacharzt">
        <dc:Bounds x="620" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Nein" bpmnElement="End_System_Nein">
        <dc:Bounds x="762" y="402" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Laden" bpmnElement="Task_S_TermineLaden">
        <dc:Bounds x="620" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_PatientBenachrichtigen" bpmnElement="Task_S_PatientBenachrichtigen">
        <dc:Bounds x="760" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Vorschlaege" bpmnElement="Task_S_TerminvorschlaegeAnPatient">
        <dc:Bounds x="760" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Wunsch" bpmnElement="Task_S_TerminwunschEmpfangen">
        <dc:Bounds x="900" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Buchen" bpmnElement="Task_S_TerminBuchen">
        <dc:Bounds x="1040" y="490" width="100" height="80" />
