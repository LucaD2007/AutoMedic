<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_02" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collab_02">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Proc_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Proc_System" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Proc_Praxis" />
    <bpmn:messageFlow id="MF01" name="Absageanfrage" sourceRef="T_P_AbsageSenden" targetRef="Start_System" />
    <bpmn:messageFlow id="MF02" name="Absagebestaetigung" sourceRef="T_S_BestaetigungSenden" targetRef="ICE_P_Bestaetigung" />
    <bpmn:messageFlow id="MF03" name="Absagebenachrichtigung" sourceRef="T_S_PraxisBenachrichtigen" targetRef="Start_Praxis" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Terminabsage gewuenscht">
      <bpmn:outgoing>F_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_P_TerminWaehlen" name="Termin zur Absage auswaehlen">
      <bpmn:incoming>F_P1</bpmn:incoming>
      <bpmn:outgoing>F_P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_P_AbsageSenden" name="Absage bestaetigen und senden">
      <bpmn:incoming>F_P2</bpmn:incoming>
      <bpmn:outgoing>F_P3</bpmn:outgoing>
      <bpmn:property id="Prop_P_Grund" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_P1">
        <bpmn:sourceRef>DOR_Absagegrund</bpmn:sourceRef>
        <bpmn:targetRef>Prop_P_Grund</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="ICE_P_Bestaetigung" name="Absagebestaetigung erhalten">
      <bpmn:incoming>F_P3</bpmn:incoming>
      <bpmn:outgoing>F_P4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ICE_P" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Patient" name="Termin abgesagt">
      <bpmn:incoming>F_P4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DOR_Absagegrund" name="Absagegrund" dataObjectRef="DO_Absagegrund" />
    <bpmn:dataObject id="DO_Absagegrund" />
    <bpmn:sequenceFlow id="F_P1" sourceRef="Start_Patient" targetRef="T_P_TerminWaehlen" />
    <bpmn:sequenceFlow id="F_P2" sourceRef="T_P_TerminWaehlen" targetRef="T_P_AbsageSenden" />
    <bpmn:sequenceFlow id="F_P3" sourceRef="T_P_AbsageSenden" targetRef="ICE_P_Bestaetigung" />
    <bpmn:sequenceFlow id="F_P4" sourceRef="ICE_P_Bestaetigung" targetRef="End_Patient" />
  </bpmn:process>
  <bpmn:process id="Proc_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Absageanfrage eingetroffen">
      <bpmn:outgoing>F_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_S" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_S_TerminPruefen" name="Termin identifizieren und Stornierbarkeit prüfen">
      <bpmn:incoming>F_S1</bpmn:incoming>
      <bpmn:outgoing>F_S2</bpmn:outgoing>
      <bpmn:property id="Prop_S_Kal" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S1">
        <bpmn:sourceRef>DSR_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_S_Stornierbar" name="Stornierung möglich?">
      <bpmn:incoming>F_S2</bpmn:incoming>
      <bpmn:outgoing>F_S3_Nein</bpmn:outgoing>
      <bpmn:outgoing>Flow_0hyhtt6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_System_Abbruch" name="Stornierung abgelehnt">
      <bpmn:incoming>F_S3_Nein</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_Abbruch" />
    </bpmn:endEvent>
    <bpmn:sendTask id="T_S_BestaetigungSenden" name="Absagebestätigung an Patient senden">
      <bpmn:incoming>Flow_1ja9hhm</bpmn:incoming>
      <bpmn:outgoing>Flow_1runpcd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_System" name="Stornierung abgeschlossen">
      <bpmn:incoming>Flow_1runpcd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DSR_Terminkalender" name="Terminkalender" />
    <bpmn:sendTask id="T_S_PraxisBenachrichtigen" name="Praxis über Absage benachrichtigen">
      <bpmn:incoming>Flow_0hyhtt6</bpmn:incoming>
      <bpmn:outgoing>Flow_1ja9hhm</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="F_S1" sourceRef="Start_System" targetRef="T_S_TerminPruefen" />
    <bpmn:sequenceFlow id="F_S2" sourceRef="T_S_TerminPruefen" targetRef="GW_S_Stornierbar" />
    <bpmn:sequenceFlow id="F_S3_Nein" name="Nein" sourceRef="GW_S_Stornierbar" targetRef="End_System_Abbruch" />
    <bpmn:sequenceFlow id="Flow_0hyhtt6" sourceRef="GW_S_Stornierbar" targetRef="T_S_PraxisBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_1ja9hhm" sourceRef="T_S_PraxisBenachrichtigen" targetRef="T_S_BestaetigungSenden" />
    <bpmn:sequenceFlow id="Flow_1runpcd" sourceRef="T_S_BestaetigungSenden" targetRef="End_System" />
  </bpmn:process>
  <bpmn:process id="Proc_Praxis" isExecutable="false">
    <bpmn:startEvent id="Start_Praxis" name="Absagebenachrichtigung erhalten">
      <bpmn:outgoing>F_Pr1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Pr" />
    </bpmn:startEvent>
    <bpmn:userTask id="T_Pr_PruefenAktualisieren" name="Absage prüfen und Kalender aktualisieren">
      <bpmn:incoming>F_Pr1</bpmn:incoming>
      <bpmn:outgoing>Flow_1pn0m6b</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1m91l75">
        <bpmn:targetRef>DSR_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Pr_Warteliste" name="Patienten auf Warteliste?">
      <bpmn:incoming>Flow_1o9w973</bpmn:incoming>
      <bpmn:outgoing>F_Pr3_Ja</bpmn:outgoing>
      <bpmn:outgoing>F_Pr3_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Pr_Nachruecker" name="Nachrücker über freien Slot informieren">
      <bpmn:incoming>F_Pr3_Ja</bpmn:incoming>
      <bpmn:outgoing>F_Pr4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Pr_Merge">
      <bpmn:incoming>F_Pr4</bpmn:incoming>
      <bpmn:incoming>F_Pr3_Nein</bpmn:incoming>
      <bpmn:outgoing>F_Pr5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Praxis" name="Absage verarbeitet">
      <bpmn:incoming>F_Pr5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DSR_Geraete" name="Geräteverwaltung" />
    <bpmn:userTask id="Activity_0mjkbi7" name="Raumbuchung und Geräte freigeben">
      <bpmn:incoming>Flow_1pn0m6b</bpmn:incoming>
      <bpmn:outgoing>Flow_1o9w973</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0uefljs">
        <bpmn:targetRef>DSR_Geraete</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_Pr1" sourceRef="Start_Praxis" targetRef="T_Pr_PruefenAktualisieren" />
    <bpmn:sequenceFlow id="Flow_1pn0m6b" sourceRef="T_Pr_PruefenAktualisieren" targetRef="Activity_0mjkbi7" />
    <bpmn:sequenceFlow id="Flow_1o9w973" sourceRef="Activity_0mjkbi7" targetRef="GW_Pr_Warteliste" />
    <bpmn:sequenceFlow id="F_Pr3_Ja" name="Ja" sourceRef="GW_Pr_Warteliste" targetRef="T_Pr_Nachruecker" />
    <bpmn:sequenceFlow id="F_Pr3_Nein" name="Nein" sourceRef="GW_Pr_Warteliste" targetRef="GW_Pr_Merge" />
    <bpmn:sequenceFlow id="F_Pr4" sourceRef="T_Pr_Nachruecker" targetRef="GW_Pr_Merge" />
    <bpmn:sequenceFlow id="F_Pr5" sourceRef="GW_Pr_Merge" targetRef="End_Praxis" />
  </bpmn:process>
