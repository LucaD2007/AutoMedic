<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_03">
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Process_Praxis" />
    <bpmn:messageFlow id="MF_01" name="Terminerinnerung" sourceRef="Task_S_Erinnerung" targetRef="Start_Patient" />
    <bpmn:messageFlow id="MF_02" name="Datumsvorschlag" sourceRef="Task_P_Bestaetigen" targetRef="IME_Bestaetigung" />
    <bpmn:messageFlow id="MF_03" name="Absagewunsch" sourceRef="Task_P_Absagen" targetRef="IME_Absage" />
    <bpmn:messageFlow id="MF_04" name="Tagesbericht" sourceRef="Task_S_Tagesbericht" targetRef="Start_Praxis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Taeglich 08:00 gestartet">
      <bpmn:outgoing>Flow_S01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Start">
        <bpmn:timeCycle>R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_S_Abfragen" name="Anstehende Termine abfragen">
      <bpmn:incoming>Flow_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S02</bpmn:outgoing>
      <bpmn:property id="Prop_S_Kal" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S1">
        <bpmn:sourceRef>DS_Terminkalender_1</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_S_Vorhanden" name="Termine vorhanden?">
      <bpmn:incoming>Flow_S02</bpmn:incoming>
      <bpmn:outgoing>Flow_S03_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_S03_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_S_Erinnerung" name="Erinnerung erstellen und versenden">
      <bpmn:incoming>Flow_S03_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S04</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_Log">
        <bpmn:targetRef>DS_Benachrichtigungslog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_S_Erinnerung">
        <bpmn:targetRef>DO_Erinnerung_Ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IME_Bestaetigung" name="Neuen Termin erhalten">
      <bpmn:incoming>Flow_S05_Best</bpmn:incoming>
      <bpmn:outgoing>Flow_S06_Best</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Best" />
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="DS_Terminkalender_1" name="Terminkalender" />
    <bpmn:sequenceFlow id="Flow_S01" sourceRef="Start_System" targetRef="Task_S_Abfragen" />
    <bpmn:sequenceFlow id="Flow_S02" sourceRef="Task_S_Abfragen" targetRef="GW_S_Vorhanden" />
    <bpmn:sequenceFlow id="Flow_S03_Ja" name="Ja" sourceRef="GW_S_Vorhanden" targetRef="Task_S_Erinnerung" />
    <bpmn:sequenceFlow id="Flow_S03_Nein" name="Nein" sourceRef="GW_S_Vorhanden" targetRef="GW_S_Merge2" />
    <bpmn:sequenceFlow id="Flow_S04" sourceRef="Task_S_Erinnerung" targetRef="GW_S_EventBased" />
    <bpmn:sequenceFlow id="Flow_S05_Best" sourceRef="GW_S_EventBased" targetRef="IME_Bestaetigung" />
    <bpmn:sequenceFlow id="Flow_S05_Absage" sourceRef="GW_S_EventBased" targetRef="IME_Absage" />
    <bpmn:sequenceFlow id="Flow_S05_Timer" sourceRef="GW_S_EventBased" targetRef="ITE_Timer" />
    <bpmn:sequenceFlow id="Flow_S06_Best" sourceRef="IME_Bestaetigung" targetRef="Task_S_StatusAkt" />
    <bpmn:sequenceFlow id="Flow_S06_Absage" sourceRef="IME_Absage" targetRef="Task_S_Stornieren" />
    <bpmn:sequenceFlow id="Flow_S07_Best" sourceRef="Task_S_StatusAkt" targetRef="GW_S_Merge1" />
    <bpmn:sequenceFlow id="Flow_S07_Absage" sourceRef="Task_S_Stornieren" targetRef="GW_S_Merge1" />
    <bpmn:sequenceFlow id="Flow_S07_Timer" sourceRef="ITE_Timer" targetRef="GW_S_Merge1" />
    <bpmn:sequenceFlow id="Flow_S08" sourceRef="GW_S_Merge1" targetRef="GW_S_Merge2" />
    <bpmn:sequenceFlow id="Flow_S09" sourceRef="GW_S_Merge2" targetRef="Task_S_Tagesbericht" />
    <bpmn:sequenceFlow id="Flow_S10" sourceRef="Task_S_Tagesbericht" targetRef="End_System" />
    <bpmn:dataObjectReference id="DO_Erinnerung_Ref" name="Erinnerungsnachricht" dataObjectRef="DO_Erinnerung" />
    <bpmn:dataObject id="DO_Erinnerung" />
    <bpmn:dataStoreReference id="DS_Benachrichtigungslog" name="Benachrichtigungslog" />
    <bpmn:endEvent id="End_System" name="Benachrichtigungszyklus abgeschlossen">
      <bpmn:incoming>Flow_S10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_S_Tagesbericht" name="Tagesbericht senden">
      <bpmn:incoming>Flow_S09</bpmn:incoming>
      <bpmn:outgoing>Flow_S10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_S_Merge2">
      <bpmn:incoming>Flow_S08</bpmn:incoming>
      <bpmn:incoming>Flow_S03_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_S09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_S_Merge1">
      <bpmn:incoming>Flow_S07_Best</bpmn:incoming>
      <bpmn:incoming>Flow_S07_Absage</bpmn:incoming>
      <bpmn:incoming>Flow_S07_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_S08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_S_Stornieren" name="Termin stornieren">
      <bpmn:incoming>Flow_S06_Absage</bpmn:incoming>
      <bpmn:outgoing>Flow_S07_Absage</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_StornoKal">
        <bpmn:targetRef>DS_Terminkalender_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_S_StatusAkt" name="Terminstatus aktualisieren">
      <bpmn:incoming>Flow_S06_Best</bpmn:incoming>
      <bpmn:outgoing>Flow_S07_Best</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_StatusKal">
        <bpmn:targetRef>DS_Terminkalender_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GW_S_EventBased" name="Reaktion abwarten">
      <bpmn:incoming>Flow_S04</bpmn:incoming>
      <bpmn:outgoing>Flow_S05_Best</bpmn:outgoing>
      <bpmn:outgoing>Flow_S05_Absage</bpmn:outgoing>
      <bpmn:outgoing>Flow_S05_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IME_Absage" name="Absage erhalten">
      <bpmn:incoming>Flow_S05_Absage</bpmn:incoming>
      <bpmn:outgoing>Flow_S06_Absage</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Absage" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ITE_Timer" name="Wartezeit abgelaufen (12h)">
      <bpmn:incoming>Flow_S05_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_S07_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Warte">
        <bpmn:timeDuration>PT12H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStoreReference id="DS_Terminkalender_2" name="Terminkalender" />
  </bpmn:process>
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Erinnerung empfangen">
      <bpmn:outgoing>Flow_P01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartP" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_P_Pruefen" name="Erinnerungs-nachchricht prüfen">
      <bpmn:incoming>Flow_P01</bpmn:incoming>
      <bpmn:outgoing>Flow_P02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_P_Entscheidung" name="Termin wahrnehmen?">
      <bpmn:incoming>Flow_P02</bpmn:incoming>
      <bpmn:outgoing>Flow_P03_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_P03_Nein</bpmn:outgoing>
      <bpmn:outgoing>Flow_P03_Ignorieren</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_P_Merge">
      <bpmn:incoming>Flow_P04_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_P04_Nein</bpmn:incoming>
      <bpmn:incoming>Flow_P03_Ignorieren</bpmn:incoming>
      <bpmn:outgoing>Flow_P05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Patient" name="Benachrichtigung abgeschlossen">
      <bpmn:incoming>Flow_P05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P01" sourceRef="Start_Patient" targetRef="Task_P_Pruefen" />
    <bpmn:sequenceFlow id="Flow_P02" sourceRef="Task_P_Pruefen" targetRef="GW_P_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_P03_Ja" name="Verschieben" sourceRef="GW_P_Entscheidung" targetRef="Task_P_Bestaetigen" />
    <bpmn:sequenceFlow id="Flow_P03_Nein" name="Nein, absagen" sourceRef="GW_P_Entscheidung" targetRef="Task_P_Absagen" />
    <bpmn:sequenceFlow id="Flow_P03_Ignorieren" name="Ja, nicht antworten" sourceRef="GW_P_Entscheidung" targetRef="GW_P_Merge" />
    <bpmn:sequenceFlow id="Flow_P04_Ja" sourceRef="Task_P_Bestaetigen" targetRef="GW_P_Merge" />
    <bpmn:sequenceFlow id="Flow_P04_Nein" sourceRef="Task_P_Absagen" targetRef="GW_P_Merge" />
    <bpmn:sequenceFlow id="Flow_P05" sourceRef="GW_P_Merge" targetRef="End_Patient" />
    <bpmn:sendTask id="Task_P_Absagen" name="Termin absagen">
      <bpmn:incoming>Flow_P03_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_P04_Nein</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_P_Bestaetigen" name="Neuen Termin vorschlagen">
      <bpmn:incoming>Flow_P03_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_P04_Ja</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
  <bpmn:process id="Process_Praxis" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_Pr01" sourceRef="Start_Praxis" targetRef="Task_Pr_BerichtPruefen" />
    <bpmn:sequenceFlow id="Flow_Pr02" sourceRef="Task_Pr_BerichtPruefen" targetRef="Task_Pr_TagesplanAnpassen" />
    <bpmn:sequenceFlow id="Flow_Pr03" sourceRef="Task_Pr_TagesplanAnpassen" targetRef="End_Praxis" />
    <bpmn:endEvent id="End_Praxis" name="Tagesvorbereitung abgeschlossen">
      <bpmn:incoming>Flow_Pr03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Pr_TagesplanAnpassen" name="Tagesplan anpassen">
      <bpmn:incoming>Flow_Pr02</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Pr_BerichtPruefen" name="Tagesbericht prüfen und nachfassen">
      <bpmn:incoming>Flow_Pr01</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Praxis" name="Tagesbericht empfangen">
      <bpmn:outgoing>Flow_Pr01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartPr" />
    </bpmn:startEvent>
  </bpmn:process>
