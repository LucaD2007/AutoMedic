<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_7" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration_07">
    <bpmn:participant id="Pool_Patient" name="Patient / Begleitperson" processRef="Process_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Process_Praxis" />
    <bpmn:messageFlow id="MF_01" name="Notfallmeldung mit Symptomen" sourceRef="Task_P_NotfallMelden" targetRef="Start_System" />
    <bpmn:messageFlow id="MF_02" name="Sofort-Bestätigung" sourceRef="Task_S_BeteiligteBenachrichtigen" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:messageFlow id="MF_03" name="Notfallalarm" sourceRef="Task_S_BeteiligteBenachrichtigen" targetRef="Start_Praxis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Notfall tritt ein">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_P_NotfallMelden" name="Notfall melden und Symptome schildern">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
      <bpmn:property id="Prop_P_Sympt" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_P1">
        <bpmn:sourceRef>DataObject_Symptome</bpmn:sourceRef>
        <bpmn:targetRef>Prop_P_Sympt</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_P_BestaetigungErhalten" name="Sofort-Bestätigung erhalten">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_P_Erstversorgung" name="Praxis aufsuchen und Erstversorgung erhalten">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Patient" name="Notfall versorgt">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObject_Symptome" name="Symptombeschreibung" dataObjectRef="DO_Symptome" />
    <bpmn:dataObject id="DO_Symptome" />
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Patient" targetRef="Task_P_NotfallMelden" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_P_NotfallMelden" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_P_BestaetigungErhalten" targetRef="Task_P_Erstversorgung" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_P_Erstversorgung" targetRef="End_Patient" />
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Notfallmeldung empfangen">
      <bpmn:outgoing>Flow_1eolqkr</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_S" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_S_ProtokollAnlegen" targetRef="Task_S_BeteiligteBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_S_BeteiligteBenachrichtigen" targetRef="End_System" />
    <bpmn:endEvent id="End_System" name="Notfall eingeplant">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_S_BeteiligteBenachrichtigen" name="Patient bestätigen und Praxis alarmieren">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="DataStore_Notfallregister" name="Notfallregister" />
    <bpmn:dataStoreReference id="DataStore_Terminkalender" name="Terminkalender" />
    <bpmn:sequenceFlow id="Flow_1eolqkr" sourceRef="Start_System" targetRef="Activity_108w2dn" />
    <bpmn:sequenceFlow id="Flow_1uk055r" sourceRef="Activity_108w2dn" targetRef="Activity_1qs29ek" />
    <bpmn:sequenceFlow id="Flow_0l0ohp1" sourceRef="Activity_1qs29ek" targetRef="Task_S_ProtokollAnlegen" />
    <bpmn:userTask id="Activity_108w2dn" name="Notfall bewerten">
      <bpmn:incoming>Flow_1eolqkr</bpmn:incoming>
      <bpmn:outgoing>Flow_1uk055r</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_1qs29ek" name="Notfalltermin zeitlich einplanen">
      <bpmn:incoming>Flow_1uk055r</bpmn:incoming>
      <bpmn:outgoing>Flow_0l0ohp1</bpmn:outgoing>
      <bpmn:property id="Property_18ggdv7" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1kpceiq">
        <bpmn:sourceRef>DataStore_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Property_18ggdv7</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1lkxotg">
        <bpmn:targetRef>DataStore_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_S_ProtokollAnlegen" name="Notfallprotokoll anlegen">
      <bpmn:incoming>Flow_0l0ohp1</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S2">
        <bpmn:targetRef>DataStore_Notfallregister</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:process id="Process_Praxis" isExecutable="false">
    <bpmn:startEvent id="Start_Praxis" name="Notfallalarm empfangen">
      <bpmn:outgoing>Flow_Pr1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Pr" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Pr_Vorbereiten" name="Behandlungsraum vorbereiten">
      <bpmn:incoming>Flow_Pr1</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr2</bpmn:outgoing>
      <bpmn:property id="Property_063v2gt" name="__targetRef_placeholder" />
