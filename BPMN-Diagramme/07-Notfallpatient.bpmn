<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_7"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="EKX DeepAgent"
                  exporterVersion="2.0">

  <!-- ====== COLLABORATION ====== -->
  <bpmn:collaboration id="Collaboration_07">
    <bpmn:participant id="Pool_Patient" name="Patient / Begleitperson" processRef="Process_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Process_Praxis" />

    <bpmn:messageFlow id="MF_01" name="Notfallmeldung mit Symptomen" sourceRef="Task_P_NotfallMelden" targetRef="Start_System" />
    <bpmn:messageFlow id="MF_02" name="Sofort-Bestaetigung" sourceRef="Task_S_BeteiligteBenachrichtigen" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:messageFlow id="MF_03" name="Notfallalarm" sourceRef="Task_S_BeteiligteBenachrichtigen" targetRef="Start_Praxis" />
  </bpmn:collaboration>

  <!-- ====== PATIENT PROCESS ====== -->
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Notfall tritt ein">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_P_NotfallMelden" name="Notfall melden und Symptome schildern">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
      <bpmn:property id="Prop_P_Sympt" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_P1">
        <bpmn:sourceRef>DataObject_Symptome</bpmn:sourceRef>
        <bpmn:targetRef>Prop_P_Sympt</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_P_BestaetigungErhalten" name="Sofort-Bestaetigung erhalten">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_P_Erstversorgung" name="Praxis aufsuchen und Erstversorgung erhalten">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Patient" name="Notfall versorgt">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObjectReference id="DataObject_Symptome" name="Symptombeschreibung" dataObjectRef="DO_Symptome" />
    <bpmn:dataObject id="DO_Symptome" />

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Patient" targetRef="Task_P_NotfallMelden" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_P_NotfallMelden" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_P_BestaetigungErhalten" targetRef="Task_P_Erstversorgung" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_P_Erstversorgung" targetRef="End_Patient" />
  </bpmn:process>

  <!-- ====== SYSTEM PROCESS ====== -->
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Notfallmeldung empfangen">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_S" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Task_S_BewertenEinplanen" name="Notfall bewerten und einplanen">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      <bpmn:property id="Prop_S_Kal" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S1">
        <bpmn:sourceRef>DataStore_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_S1">
        <bpmn:targetRef>DataStore_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:subProcess>
    <bpmn:task id="Task_S_ProtokollAnlegen" name="Notfallprotokoll anlegen">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S2">
        <bpmn:targetRef>DataStore_Notfallregister</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sendTask id="Task_S_BeteiligteBenachrichtigen" name="Patient bestaetigen und Praxis alarmieren">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_System" name="Notfall eingeplant">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataStoreReference id="DataStore_Terminkalender" name="Terminkalender" />
    <bpmn:dataStoreReference id="DataStore_Notfallregister" name="Notfallregister" />

    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_System" targetRef="Task_S_BewertenEinplanen" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_S_BewertenEinplanen" targetRef="Task_S_ProtokollAnlegen" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_S_ProtokollAnlegen" targetRef="Task_S_BeteiligteBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_S_BeteiligteBenachrichtigen" targetRef="End_System" />
  </bpmn:process>

  <!-- ====== PRAXIS PROCESS ====== -->
  <bpmn:process id="Process_Praxis" isExecutable="false">
    <bpmn:startEvent id="Start_Praxis" name="Notfallalarm empfangen">
      <bpmn:outgoing>Flow_Pr1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Pr" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Pr_Vorbereiten" name="Behandlungsraum vorbereiten">
      <bpmn:incoming>Flow_Pr1</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Pr_Behandeln" name="Notfallpatienten behandeln">
      <bpmn:incoming>Flow_Pr2</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Pr_Dokumentieren" name="Behandlung dokumentieren und Protokoll abschliessen">
      <bpmn:incoming>Flow_Pr3</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Praxis" name="Notfall behandelt">
      <bpmn:incoming>Flow_Pr4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Pr1" sourceRef="Start_Praxis" targetRef="Task_Pr_Vorbereiten" />
    <bpmn:sequenceFlow id="Flow_Pr2" sourceRef="Task_Pr_Vorbereiten" targetRef="Task_Pr_Behandeln" />
    <bpmn:sequenceFlow id="Flow_Pr3" sourceRef="Task_Pr_Behandeln" targetRef="Task_Pr_Dokumentieren" />
    <bpmn:sequenceFlow id="Flow_Pr4" sourceRef="Task_Pr_Dokumentieren" targetRef="End_Praxis" />
  </bpmn:process>

  <!-- ====== DIAGRAM ====== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_07">

      <!-- PATIENT POOL -->
      <bpmndi:BPMNShape id="Shape_Pool_Patient" bpmnElement="Pool_Patient" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1000" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Patient" bpmnElement="Start_Patient">
        <dc:Bounds x="222" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="205" y="195" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_Melden" bpmnElement="Task_P_NotfallMelden">
        <dc:Bounds x="300" y="130" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_Bestaetigung" bpmnElement="Task_P_BestaetigungErhalten">
        <dc:Bounds x="640" y="130" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_Erstversorgung" bpmnElement="Task_P_Erstversorgung">
        <dc:Bounds x="900" y="130" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Patient" bpmnElement="End_Patient">
        <dc:Bounds x="1092" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1072" y="195" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DO_Symptome" bpmnElement="DataObject_Symptome">
        <dc:Bounds x="347" y="80" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="325" y="68" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_P1" bpmnElement="Flow_P1"><di:waypoint x="258" y="170" /><di:waypoint x="300" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P2" bpmnElement="Flow_P2"><di:waypoint x="430" y="170" /><di:waypoint x="640" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P3" bpmnElement="Flow_P3"><di:waypoint x="770" y="170" /><di:waypoint x="900" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P4" bpmnElement="Flow_P4"><di:waypoint x="1040" y="170" /><di:waypoint x="1092" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DIA_P1" bpmnElement="DIA_P1"><di:waypoint x="365" y="130" /><di:waypoint x="365" y="130" /></bpmndi:BPMNEdge>

      <!-- SYSTEM POOL -->
      <bpmndi:BPMNShape id="Shape_Pool_System" bpmnElement="Pool_System" isHorizontal="true">
        <dc:Bounds x="160" y="320" width="1000" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_System" bpmnElement="Start_System">
        <dc:Bounds x="222" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="205" y="465" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Bewerten" bpmnElement="Task_S_BewertenEinplanen">
        <dc:Bounds x="300" y="400" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Protokoll" bpmnElement="Task_S_ProtokollAnlegen">
        <dc:Bounds x="510" y="400" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Benachrichtigen" bpmnElement="Task_S_BeteiligteBenachrichtigen">
        <dc:Bounds x="700" y="400" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_System" bpmnElement="End_System">
        <dc:Bounds x="912" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="892" y="465" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DS_Kalender" bpmnElement="DataStore_Terminkalender">
        <dc:Bounds x="350" y="500" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="340" y="550" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DS_Notfall" bpmnElement="DataStore_Notfallregister">
        <dc:Bounds x="550" y="500" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="535" y="550" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_S1" bpmnElement="Flow_S1"><di:waypoint x="258" y="440" /><di:waypoint x="300" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_S2" bpmnElement="Flow_S2"><di:waypoint x="450" y="440" /><di:waypoint x="510" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_S3" bpmnElement="Flow_S3"><di:waypoint x="640" y="440" /><di:waypoint x="700" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_S4" bpmnElement="Flow_S4"><di:waypoint x="850" y="440" /><di:waypoint x="912" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DIA_S1" bpmnElement="DIA_S1"><di:waypoint x="375" y="500" /><di:waypoint x="375" y="480" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_S1" bpmnElement="DOA_S1"><di:waypoint x="400" y="480" /><di:waypoint x="400" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_S2" bpmnElement="DOA_S2"><di:waypoint x="575" y="480" /><di:waypoint x="575" y="500" /></bpmndi:BPMNEdge>

      <!-- PRAXIS POOL -->
      <bpmndi:BPMNShape id="Shape_Pool_Praxis" bpmnElement="Pool_Praxis" isHorizontal="true">
        <dc:Bounds x="160" y="620" width="1000" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Praxis" bpmnElement="Start_Praxis">
        <dc:Bounds x="702" y="702" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="685" y="745" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pr_Vorbereiten" bpmnElement="Task_Pr_Vorbereiten">
        <dc:Bounds x="780" y="680" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pr_Behandeln" bpmnElement="Task_Pr_Behandeln">
        <dc:Bounds x="780" y="560" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pr_Dokumentieren" bpmnElement="Task_Pr_Dokumentieren">
        <dc:Bounds x="950" y="560" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Praxis" bpmnElement="End_Praxis">
        <dc:Bounds x="1092" y="702" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1072" y="745" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Pr1" bpmnElement="Flow_Pr1"><di:waypoint x="738" y="720" /><di:waypoint x="780" y="720" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Pr2" bpmnElement="Flow_Pr2"><di:waypoint x="840" y="680" /><di:waypoint x="840" y="620" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Pr3" bpmnElement="Flow_Pr3"><di:waypoint x="900" y="590" /><di:waypoint x="950" y="590" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Pr4" bpmnElement="Flow_Pr4"><di:waypoint x="1100" y="620" /><di:waypoint x="1110" y="702" /></bpmndi:BPMNEdge>

      <!-- MESSAGE FLOWS -->
      <bpmndi:BPMNEdge id="Edge_MF01" bpmnElement="MF_01">
        <di:waypoint x="365" y="210" /><di:waypoint x="365" y="300" /><di:waypoint x="240" y="300" /><di:waypoint x="240" y="422" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF02" bpmnElement="MF_02">
        <di:waypoint x="775" y="400" /><di:waypoint x="775" y="300" /><di:waypoint x="705" y="300" /><di:waypoint x="705" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MF03" bpmnElement="MF_03">
        <di:waypoint x="775" y="480" /><di:waypoint x="775" y="640" /><di:waypoint x="720" y="640" /><di:waypoint x="720" y="702" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
