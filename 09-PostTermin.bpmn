<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_09"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- ============================================================ -->
  <!--  COLLABORATION                                                -->
  <!-- ============================================================ -->
  <collaboration id="Collaboration_09">
    <participant id="Pool_Arzt" name="Arzt" processRef="Process_Arzt" />
    <participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />

    <messageFlow id="MF1" name="Behandlungsdaten uebermitteln" sourceRef="Task_A2" targetRef="Task_S1" />
    <messageFlow id="MF2" name="Rezept zur Freigabe" sourceRef="Task_A5" targetRef="Task_S5" />
    <messageFlow id="MF3" name="Folgeaktion erfasst" sourceRef="Task_A8" targetRef="Task_S9" />
    <messageFlow id="MF4" name="Zusammenfassung" sourceRef="Task_S12" targetRef="Task_P1" />
    <messageFlow id="MF5" name="Rezept digital" sourceRef="Task_S7" targetRef="Task_P2" />
    <messageFlow id="MF6" name="Folgetermin-Vorschlaege" sourceRef="Task_S11" targetRef="Task_P4" />
    <messageFlow id="MF7" name="Terminwahl" sourceRef="Task_P5" targetRef="Task_S11b" />
    <messageFlow id="MF8" name="Feedback-Anfrage" sourceRef="Task_S13" targetRef="Task_P6" />
    <messageFlow id="MF9" name="Feedback" sourceRef="Task_P7" targetRef="Task_S14" />
  </collaboration>

  <!-- ============================================================ -->
  <!--  ARZT                                                         -->
  <!-- ============================================================ -->
  <process id="Process_Arzt" isExecutable="false">
    <startEvent id="Start_A" name="Behandlung abgeschlossen" />
    <task id="Task_A1" name="Behandlung dokumentieren" />
    <task id="Task_A2" name="Behandlungsdaten im System erfassen" />
    <task id="Task_A3" name="Diagnose und Massnahmen festhalten" />
    <exclusiveGateway id="GW_A1" name="Rezept erforderlich?" />
    <task id="Task_A4" name="Rezept erstellen" />
    <task id="Task_A5" name="Rezept digital signieren und freigeben" />
    <exclusiveGateway id="GW_A2" name="Folgeaktion noetig?" />
    <task id="Task_A6" name="Folgetermin anordnen" />
    <task id="Task_A7" name="Ueberweisung ausstellen" />
    <exclusiveGateway id="GW_A2_merge" />
    <task id="Task_A8" name="Folgeaktion im System erfassen" />
    <exclusiveGateway id="GW_A1_merge" />
    <task id="Task_A9" name="Patientenakte abschliessen" />
    <endEvent id="End_A" name="Post-Termin abgeschlossen" />

    <dataObjectReference id="DO_Diagnose" name="Diagnosebericht" dataObjectRef="DataObj_Diagnose" />
    <dataObject id="DataObj_Diagnose" />
    <dataObjectReference id="DO_Rezept" name="Rezept" dataObjectRef="DataObj_Rezept" />
    <dataObject id="DataObj_Rezept" />

    <sequenceFlow id="sf_a1" sourceRef="Start_A" targetRef="Task_A1" />
    <sequenceFlow id="sf_a2" sourceRef="Task_A1" targetRef="Task_A2" />
    <sequenceFlow id="sf_a3" sourceRef="Task_A2" targetRef="Task_A3" />
    <sequenceFlow id="sf_a4" sourceRef="Task_A3" targetRef="GW_A1" />
    <sequenceFlow id="sf_a5" name="Ja" sourceRef="GW_A1" targetRef="Task_A4" />
    <sequenceFlow id="sf_a6" sourceRef="Task_A4" targetRef="Task_A5" />
    <sequenceFlow id="sf_a7" sourceRef="Task_A5" targetRef="GW_A2" />
    <sequenceFlow id="sf_a8" name="Nein" sourceRef="GW_A1" targetRef="GW_A1_merge" />
    <sequenceFlow id="sf_a9" name="Folgetermin" sourceRef="GW_A2" targetRef="Task_A6" />
    <sequenceFlow id="sf_a10" name="Ueberweisung" sourceRef="GW_A2" targetRef="Task_A7" />
    <sequenceFlow id="sf_a11" sourceRef="Task_A6" targetRef="GW_A2_merge" />
    <sequenceFlow id="sf_a12" sourceRef="Task_A7" targetRef="GW_A2_merge" />
    <sequenceFlow id="sf_a13" name="Keine" sourceRef="GW_A2" targetRef="GW_A1_merge" />
    <sequenceFlow id="sf_a14" sourceRef="GW_A2_merge" targetRef="Task_A8" />
    <sequenceFlow id="sf_a15" sourceRef="Task_A8" targetRef="GW_A1_merge" />
    <sequenceFlow id="sf_a16" sourceRef="GW_A1_merge" targetRef="Task_A9" />
    <sequenceFlow id="sf_a17" sourceRef="Task_A9" targetRef="End_A" />
  </process>

  <!-- ============================================================ -->
  <!--  SYSTEM                                                       -->
  <!-- ============================================================ -->
  <process id="Process_System" isExecutable="false">
    <startEvent id="Start_S" name="Behandlungsdaten empfangen" />
    <task id="Task_S1" name="Behandlungsdaten empfangen" />
    <task id="Task_S2" name="Patientenakte aktualisieren" />
    <task id="Task_S3" name="Diagnose und Massnahmen speichern" />
    <task id="Task_S4" name="Abrechnungsdaten vorbereiten" />
    <task id="Task_S5" name="Rezeptfreigabe empfangen" />
    <task id="Task_S6" name="Rezept validieren und speichern" />
    <task id="Task_S7" name="Rezept digital an Patient senden" />
    <exclusiveGateway id="GW_S1" name="Apotheke vorgemerkt?" />
    <task id="Task_S8" name="Rezept an Apotheke weiterleiten" />
    <exclusiveGateway id="GW_S1_merge" />
    <task id="Task_S9" name="Folgeaktion empfangen" />
    <exclusiveGateway id="GW_S2" name="Art der Folgeaktion?" />
    <task id="Task_S10" name="Freie Folgetermine ermitteln" />
    <task id="Task_S11" name="Terminvorschlaege an Patient senden" />
    <task id="Task_S11b" name="Terminwahl empfangen und buchen" />
    <task id="Task_S10b" name="Ueberweisung erstellen und speichern" />
    <exclusiveGateway id="GW_S2_merge" />
    <task id="Task_S12" name="Zusammenfassung an Patient senden" />
    <task id="Task_S13" name="Feedback-Anfrage an Patient senden" />
    <task id="Task_S14" name="Feedback empfangen und speichern" />
    <endEvent id="End_S" name="Post-Termin-Verarbeitung abgeschlossen" />

    <dataStoreReference id="DS_Patientenakte" name="Patientendatenbank" />
    <dataStoreReference id="DS_Rezepte" name="Rezeptdatenbank" />
    <dataStoreReference id="DS_Termine" name="Terminkalender" />

    <sequenceFlow id="sf_s1" sourceRef="Start_S" targetRef="Task_S1" />
    <sequenceFlow id="sf_s2" sourceRef="Task_S1" targetRef="Task_S2" />
    <sequenceFlow id="sf_s3" sourceRef="Task_S2" targetRef="Task_S3" />
    <sequenceFlow id="sf_s4" sourceRef="Task_S3" targetRef="Task_S4" />
    <sequenceFlow id="sf_s5" sourceRef="Task_S4" targetRef="Task_S5" />
    <sequenceFlow id="sf_s6" sourceRef="Task_S5" targetRef="Task_S6" />
    <sequenceFlow id="sf_s7" sourceRef="Task_S6" targetRef="Task_S7" />
    <sequenceFlow id="sf_s8" sourceRef="Task_S7" targetRef="GW_S1" />
    <sequenceFlow id="sf_s9" name="Ja" sourceRef="GW_S1" targetRef="Task_S8" />
    <sequenceFlow id="sf_s10" sourceRef="Task_S8" targetRef="GW_S1_merge" />
    <sequenceFlow id="sf_s11" name="Nein" sourceRef="GW_S1" targetRef="GW_S1_merge" />
    <sequenceFlow id="sf_s12" sourceRef="GW_S1_merge" targetRef="Task_S9" />
    <sequenceFlow id="sf_s13" sourceRef="Task_S9" targetRef="GW_S2" />
    <sequenceFlow id="sf_s14" name="Folgetermin" sourceRef="GW_S2" targetRef="Task_S10" />
    <sequenceFlow id="sf_s15" sourceRef="Task_S10" targetRef="Task_S11" />
    <sequenceFlow id="sf_s16" sourceRef="Task_S11" targetRef="Task_S11b" />
    <sequenceFlow id="sf_s17" sourceRef="Task_S11b" targetRef="GW_S2_merge" />
    <sequenceFlow id="sf_s18" name="Ueberweisung" sourceRef="GW_S2" targetRef="Task_S10b" />
    <sequenceFlow id="sf_s19" sourceRef="Task_S10b" targetRef="GW_S2_merge" />
    <sequenceFlow id="sf_s20" name="Keine" sourceRef="GW_S2" targetRef="GW_S2_merge" />
    <sequenceFlow id="sf_s21" sourceRef="GW_S2_merge" targetRef="Task_S12" />
    <sequenceFlow id="sf_s22" sourceRef="Task_S12" targetRef="Task_S13" />
    <sequenceFlow id="sf_s23" sourceRef="Task_S13" targetRef="Task_S14" />
    <sequenceFlow id="sf_s24" sourceRef="Task_S14" targetRef="End_S" />
  </process>

  <!-- ============================================================ -->
  <!--  PATIENT                                                      -->
  <!-- ============================================================ -->
  <process id="Process_Patient" isExecutable="false">
    <startEvent id="Start_P" name="Zusammenfassung erhalten" />
    <task id="Task_P1" name="Zusammenfassung des Termins einsehen" />
    <task id="Task_P2" name="Digitales Rezept empfangen" />
    <task id="Task_P3" name="Rezept pruefen und speichern" />
    <task id="Task_P4" name="Folgetermin-Vorschlaege erhalten" />
    <task id="Task_P5" name="Folgetermin auswaehlen und bestaetigen" />
    <task id="Task_P6" name="Feedback-Anfrage erhalten" />
    <exclusiveGateway id="GW_P1" name="Feedback geben?" />
    <task id="Task_P7" name="Feedback verfassen und absenden" />
    <exclusiveGateway id="GW_P1_merge" />
    <endEvent id="End_P" name="Post-Termin abgeschlossen" />

    <sequenceFlow id="sf_p1" sourceRef="Start_P" targetRef="Task_P1" />
    <sequenceFlow id="sf_p2" sourceRef="Task_P1" targetRef="Task_P2" />
    <sequenceFlow id="sf_p3" sourceRef="Task_P2" targetRef="Task_P3" />
    <sequenceFlow id="sf_p4" sourceRef="Task_P3" targetRef="Task_P4" />
    <sequenceFlow id="sf_p5" sourceRef="Task_P4" targetRef="Task_P5" />
    <sequenceFlow id="sf_p6" sourceRef="Task_P5" targetRef="Task_P6" />
    <sequenceFlow id="sf_p7" sourceRef="Task_P6" targetRef="GW_P1" />
    <sequenceFlow id="sf_p8" name="Ja" sourceRef="GW_P1" targetRef="Task_P7" />
    <sequenceFlow id="sf_p9" sourceRef="Task_P7" targetRef="GW_P1_merge" />
    <sequenceFlow id="sf_p10" name="Nein" sourceRef="GW_P1" targetRef="GW_P1_merge" />
    <sequenceFlow id="sf_p11" sourceRef="GW_P1_merge" targetRef="End_P" />
  </process>

  <!-- ============================================================ -->
  <!--  DIAGRAM                                                      -->
  <!-- ============================================================ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_09">
    <bpmndi:BPMNPlane id="BPMNPlane_09" bpmnElement="Collaboration_09">

