      <!-- Sequence Flows Arzt -->
      <bpmndi:BPMNEdge id="Edge_sf_a1" bpmnElement="sf_a1"><omgdi:waypoint x="246" y="150" /><omgdi:waypoint x="280" y="150" /></bpmndi:BPMNEdge>
