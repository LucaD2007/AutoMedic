<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_2"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="EKX DeepAgent"
                  exporterVersion="1.0">

  <!-- ====== COLLABORATION ====== -->
  <bpmn:collaboration id="Collaboration_02">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Process_Praxis" />

    <bpmn:messageFlow id="MF_01" name="Absageanfrage" sourceRef="Task_P_AbsageBestaetigen" targetRef="Task_S_AbsageEmpfangen" />
    <bpmn:messageFlow id="MF_02" name="Absagebestaetigung" sourceRef="Task_S_BestaetigungPatient" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:messageFlow id="MF_03" name="Absagebenachrichtigung" sourceRef="Task_S_BenachrichtigungPraxis" targetRef="Task_Pr_BenachrichtigungErhalten" />
  </bpmn:collaboration>

  <!-- ====== PATIENT PROCESS ====== -->
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Patient moechte Termin absagen">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_P_Anmelden" name="Plattform aufrufen und anmelden">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P_TermineEinsehen" name="Gebuchte Termine einsehen">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P_TerminAuswaehlen" name="Zu stornierenden Termin auswaehlen">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P_GrundAngeben" name="Absagegrund angeben (optional)">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
      <bpmn:property id="Property_P_Grund" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_P1">
        <bpmn:sourceRef>DataObject_Absagegrund</bpmn:sourceRef>
        <bpmn:targetRef>Property_P_Grund</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_P_AbsageBestaetigen" name="Absage bestaetigen">
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_P6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_P_BestaetigungErhalten" name="Absagebestaetigung erhalten">
      <bpmn:incoming>Flow_P6</bpmn:incoming>
      <bpmn:outgoing>Flow_P7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Patient" name="Termin abgesagt">
      <bpmn:incoming>Flow_P7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObjectReference id="DataObject_Absagegrund" name="Absagegrund" dataObjectRef="DO_Absagegrund" />
    <bpmn:dataObject id="DO_Absagegrund" />

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Patient" targetRef="Task_P_Anmelden" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_P_Anmelden" targetRef="Task_P_TermineEinsehen" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_P_TermineEinsehen" targetRef="Task_P_TerminAuswaehlen" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_P_TerminAuswaehlen" targetRef="Task_P_GrundAngeben" />
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Task_P_GrundAngeben" targetRef="Task_P_AbsageBestaetigen" />
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Task_P_AbsageBestaetigen" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:sequenceFlow id="Flow_P7" sourceRef="Task_P_BestaetigungErhalten" targetRef="End_Patient" />
  </bpmn:process>

  <!-- ====== SYSTEM PROCESS ====== -->
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Start_System" name="Absageanfrage eingetroffen">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_S" />
    </bpmn:startEvent>
    <bpmn:task id="Task_S_AbsageEmpfangen" name="Absageanfrage verarbeiten">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_S_TerminSuchen" name="Termin im Kalender identifizieren">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
      <bpmn:property id="Property_S_Kalender" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S1">
        <bpmn:sourceRef>DataStore_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Property_S_Kalender</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_S_Stornierbar" name="Stornierung moeglich?">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_S4_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_S_BuchungStornieren" name="Terminbuchung stornieren">
      <bpmn:incoming>Flow_S4_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S1">
        <bpmn:targetRef>DataStore_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_S_SlotFreigeben" name="Zeitslot im Kalender freigeben">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_S6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S2">
        <bpmn:targetRef>DataStore_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_S_Geraete" name="Geraete reserviert?">
      <bpmn:incoming>Flow_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_S7_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_S7_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_S_GeraeteFreigeben" name="Geraetereservierung aufheben (entbuchen)">
      <bpmn:incoming>Flow_S7_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S8</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S3">
        <bpmn:targetRef>DataStore_Geraete</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_S_Merge" name="">
      <bpmn:incoming>Flow_S8</bpmn:incoming>
      <bpmn:incoming>Flow_S7_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_S9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_S_BestaetigungPatient" name="Absagebestaetigung an Patient senden">
      <bpmn:incoming>Flow_S9</bpmn:incoming>
      <bpmn:outgoing>Flow_S10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_S_BenachrichtigungPraxis" name="Praxis ueber Absage benachrichtigen">
      <bpmn:incoming>Flow_S10</bpmn:incoming>
      <bpmn:outgoing>Flow_S11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_System" name="Stornierung abgeschlossen">
      <bpmn:incoming>Flow_S11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_System_Abbruch" name="Stornierung nicht moeglich">
      <bpmn:incoming>Flow_S4_Nein</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_Abbruch" />
    </bpmn:endEvent>

    <bpmn:dataStoreReference id="DataStore_Terminkalender" name="Terminkalender" />
    <bpmn:dataStoreReference id="DataStore_Geraete" name="Geraeteverwaltung" />

    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_System" targetRef="Task_S_AbsageEmpfangen" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_S_AbsageEmpfangen" targetRef="Task_S_TerminSuchen" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_S_TerminSuchen" targetRef="GW_S_Stornierbar" />
    <bpmn:sequenceFlow id="Flow_S4_Ja" name="Ja" sourceRef="GW_S_Stornierbar" targetRef="Task_S_BuchungStornieren" />
    <bpmn:sequenceFlow id="Flow_S4_Nein" name="Nein" sourceRef="GW_S_Stornierbar" targetRef="End_System_Abbruch" />
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_S_BuchungStornieren" targetRef="Task_S_SlotFreigeben" />
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="Task_S_SlotFreigeben" targetRef="GW_S_Geraete" />
    <bpmn:sequenceFlow id="Flow_S7_Ja" name="Ja" sourceRef="GW_S_Geraete" targetRef="Task_S_GeraeteFreigeben" />
    <bpmn:sequenceFlow id="Flow_S7_Nein" name="Nein" sourceRef="GW_S_Geraete" targetRef="GW_S_Merge" />
    <bpmn:sequenceFlow id="Flow_S8" sourceRef="Task_S_GeraeteFreigeben" targetRef="GW_S_Merge" />
    <bpmn:sequenceFlow id="Flow_S9" sourceRef="GW_S_Merge" targetRef="Task_S_BestaetigungPatient" />
    <bpmn:sequenceFlow id="Flow_S10" sourceRef="Task_S_BestaetigungPatient" targetRef="Task_S_BenachrichtigungPraxis" />
    <bpmn:sequenceFlow id="Flow_S11" sourceRef="Task_S_BenachrichtigungPraxis" targetRef="End_System" />
  </bpmn:process>

  <!-- ====== PRAXIS PROCESS ====== -->
  <bpmn:process id="Process_Praxis" isExecutable="false">
    <bpmn:startEvent id="Start_Praxis" name="Absagebenachrichtigung erhalten">
      <bpmn:outgoing>Flow_Pr1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Pr" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Pr_BenachrichtigungErhalten" name="Absagebenachrichtigung pruefen">
      <bpmn:incoming>Flow_Pr1</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Pr_KalenderAktualisieren" name="Praxiskalender aktualisieren">
      <bpmn:incoming>Flow_Pr2</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Pr_Warteliste" name="Patienten auf Warteliste?">
      <bpmn:incoming>Flow_Pr3</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr4_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pr4_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Pr_NachrueckerBenachrichtigen" name="Nachruecker ueber freien Slot informieren">
      <bpmn:incoming>Flow_Pr4_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Pr_Merge" name="">
      <bpmn:incoming>Flow_Pr5</bpmn:incoming>
      <bpmn:incoming>Flow_Pr4_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Praxis" name="Absage verarbeitet">
      <bpmn:incoming>Flow_Pr6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Pr1" sourceRef="Start_Praxis" targetRef="Task_Pr_BenachrichtigungErhalten" />
    <bpmn:sequenceFlow id="Flow_Pr2" sourceRef="Task_Pr_BenachrichtigungErhalten" targetRef="Task_Pr_KalenderAktualisieren" />
    <bpmn:sequenceFlow id="Flow_Pr3" sourceRef="Task_Pr_KalenderAktualisieren" targetRef="GW_Pr_Warteliste" />
    <bpmn:sequenceFlow id="Flow_Pr4_Ja" name="Ja" sourceRef="GW_Pr_Warteliste" targetRef="Task_Pr_NachrueckerBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_Pr4_Nein" name="Nein" sourceRef="GW_Pr_Warteliste" targetRef="GW_Pr_Merge" />
    <bpmn:sequenceFlow id="Flow_Pr5" sourceRef="Task_Pr_NachrueckerBenachrichtigen" targetRef="GW_Pr_Merge" />
    <bpmn:sequenceFlow id="Flow_Pr6" sourceRef="GW_Pr_Merge" targetRef="End_Praxis" />
  </bpmn:process>

  <!-- ====== DIAGRAM ====== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_02">

      <!-- ===== PATIENT POOL ===== -->
      <bpmndi:BPMNShape id="Shape_Pool_Patient" bpmnElement="Pool_Patient" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1400" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Patient" bpmnElement="Start_Patient">
        <dc:Bounds x="232" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="208" y="205" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_Anmelden" bpmnElement="Task_P_Anmelden">
        <dc:Bounds x="310" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_TermineEinsehen" bpmnElement="Task_P_TermineEinsehen">
        <dc:Bounds x="450" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_TerminAuswaehlen" bpmnElement="Task_P_TerminAuswaehlen">
        <dc:Bounds x="590" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_GrundAngeben" bpmnElement="Task_P_GrundAngeben">
        <dc:Bounds x="730" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_AbsageBestaetigen" bpmnElement="Task_P_AbsageBestaetigen">
        <dc:Bounds x="880" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_BestaetigungErhalten" bpmnElement="Task_P_BestaetigungErhalten">
        <dc:Bounds x="1170" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Patient" bpmnElement="End_Patient">
        <dc:Bounds x="1322" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1300" y="205" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataObject_Absagegrund" bpmnElement="DataObject_Absagegrund">
        <dc:Bounds x="752" y="80" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="790" y="90" width="65" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Patient Flows -->
      <bpmndi:BPMNEdge id="Edge_P1" bpmnElement="Flow_P1">
        <di:waypoint x="268" y="180" /><di:waypoint x="310" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P2" bpmnElement="Flow_P2">
        <di:waypoint x="410" y="180" /><di:waypoint x="450" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P3" bpmnElement="Flow_P3">
        <di:waypoint x="550" y="180" /><di:waypoint x="590" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P4" bpmnElement="Flow_P4">
        <di:waypoint x="690" y="180" /><di:waypoint x="730" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P5" bpmnElement="Flow_P5">
        <di:waypoint x="830" y="180" /><di:waypoint x="880" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P6" bpmnElement="Flow_P6">
        <di:waypoint x="980" y="180" /><di:waypoint x="1170" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P7" bpmnElement="Flow_P7">
        <di:waypoint x="1270" y="180" /><di:waypoint x="1322" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DIA_P1" bpmnElement="DIA_P1">
        <di:waypoint x="770" y="130" /><di:waypoint x="770" y="140" />
      </bpmndi:BPMNEdge>

      <!-- ===== SYSTEM POOL ===== -->
      <bpmndi:BPMNShape id="Shape_Pool_System" bpmnElement="Pool_System" isHorizontal="true">
        <dc:Bounds x="160" y="370" width="1400" height="330" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_System" bpmnElement="Start_System">
        <dc:Bounds x="232" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="208" y="545" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_AbsageEmpfangen" bpmnElement="Task_S_AbsageEmpfangen">
        <dc:Bounds x="310" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_TerminSuchen" bpmnElement="Task_S_TerminSuchen">
        <dc:Bounds x="450" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Stornierbar" bpmnElement="GW_S_Stornierbar" isMarkerVisible="true">
        <dc:Bounds x="585" y="495" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="565" y="552" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_BuchungStornieren" bpmnElement="Task_S_BuchungStornieren">
        <dc:Bounds x="670" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_SlotFreigeben" bpmnElement="Task_S_SlotFreigeben">
        <dc:Bounds x="810" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Geraete" bpmnElement="GW_S_Geraete" isMarkerVisible="true">
        <dc:Bounds x="945" y="495" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="925" y="552" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_GeraeteFreigeben" bpmnElement="Task_S_GeraeteFreigeben">
        <dc:Bounds x="920" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Merge" bpmnElement="GW_S_Merge" isMarkerVisible="true">
        <dc:Bounds x="1055" y="495" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_BestaetigungPatient" bpmnElement="Task_S_BestaetigungPatient">
        <dc:Bounds x="1140" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_BenachrichtigungPraxis" bpmnElement="Task_S_BenachrichtigungPraxis">
        <dc:Bounds x="1280" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_System" bpmnElement="End_System">
        <dc:Bounds x="1422" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1395" y="545" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_System_Abbruch" bpmnElement="End_System_Abbruch">
        <dc:Bounds x="592" y="622" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="565" y="665" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Data Stores -->
      <bpmndi:BPMNShape id="Shape_DS_Terminkalender" bpmnElement="DataStore_Terminkalender">
        <dc:Bounds x="475" y="620" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="465" y="677" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DS_Geraete" bpmnElement="DataStore_Geraete">
        <dc:Bounds x="1050" y="390" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1030" y="377" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- System Flows -->
      <bpmndi:BPMNEdge id="Edge_S1" bpmnElement="Flow_S1">
        <di:waypoint x="268" y="520" /><di:waypoint x="310" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_S2" bpmnElement="Flow_S2">
        <di:waypoint x="410" y="520" /><di:waypoint x="450" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_S3" bpmnElement="Flow_S3">
        <di:waypoint x="550" y="520" /><di:waypoint x="585" y="520" />
      </bpmndi:BPMNEdge>
