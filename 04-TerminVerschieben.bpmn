<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_4"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="EKX DeepAgent"
                  exporterVersion="1.0">

  <!-- ====== COLLABORATION ====== -->
  <bpmn:collaboration id="Collaboration_04">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_System" name="Terminbuchungsplattform" processRef="Process_System" />
    <bpmn:participant id="Pool_Praxis" name="Arztpraxis" processRef="Process_Praxis" />

    <bpmn:messageFlow id="MF_01" name="Verschiebungsanfrage" sourceRef="Task_P_AnfrageAbsenden" targetRef="Task_S_AnfrageEmpfangen" />
    <bpmn:messageFlow id="MF_02" name="Alternative Termine" sourceRef="Task_S_AlternativenAnzeigen" targetRef="Task_P_AlternativenErhalten" />
    <bpmn:messageFlow id="MF_03" name="Neuer Terminwunsch" sourceRef="Task_P_NeuenTerminWaehlen" targetRef="Task_S_NeuenTerminEmpfangen" />
    <bpmn:messageFlow id="MF_04" name="Verschiebungsbestaetigung" sourceRef="Task_S_BestaetigungSenden" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:messageFlow id="MF_05" name="Aenderungsbenachrichtigung" sourceRef="Task_S_PraxisBenachrichtigen" targetRef="Start_Praxis" />
    <bpmn:messageFlow id="MF_06" name="Abbruchmeldung" sourceRef="Task_S_AbbruchSenden" targetRef="Task_P_AbbruchErhalten" />
  </bpmn:collaboration>

  <!-- ====== PATIENT PROCESS ====== -->
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:startEvent id="Start_Patient" name="Patient moechte Termin verschieben">
      <bpmn:outgoing>Flow_P01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_P_Anmelden" name="Plattform aufrufen und anmelden">
      <bpmn:incoming>Flow_P01</bpmn:incoming>
      <bpmn:outgoing>Flow_P02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_TermineEinsehen" name="Gebuchte Termine einsehen">
      <bpmn:incoming>Flow_P02</bpmn:incoming>
      <bpmn:outgoing>Flow_P03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_TerminAuswaehlen" name="Zu verschiebenden Termin auswaehlen">
      <bpmn:incoming>Flow_P03</bpmn:incoming>
      <bpmn:outgoing>Flow_P04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_GrundAngeben" name="Verschiebungsgrund angeben (optional)">
      <bpmn:incoming>Flow_P04</bpmn:incoming>
      <bpmn:outgoing>Flow_P05</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_P_Grund">
        <bpmn:targetRef>DataObject_Grund</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_P_AnfrageAbsenden" name="Verschiebungsanfrage absenden">
      <bpmn:incoming>Flow_P05</bpmn:incoming>
      <bpmn:outgoing>Flow_P06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_P_Ergebnis" name="Verschiebung moeglich?">
      <bpmn:incoming>Flow_P06</bpmn:incoming>
      <bpmn:outgoing>Flow_P07_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Pfad: moeglich -->
    <bpmn:task id="Task_P_AlternativenErhalten" name="Alternative Termine erhalten">
      <bpmn:incoming>Flow_P07_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_P08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_NeuenTerminWaehlen" name="Neuen Termin auswaehlen und bestaetigen">
      <bpmn:incoming>Flow_P08</bpmn:incoming>
      <bpmn:outgoing>Flow_P09</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_P_BestaetigungErhalten" name="Verschiebungsbestaetigung erhalten">
      <bpmn:incoming>Flow_P09</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_Ja</bpmn:outgoing>
    </bpmn:task>

    <!-- Pfad: nicht moeglich -->
    <bpmn:task id="Task_P_AbbruchErhalten" name="Hinweis erhalten: Verschiebung nicht moeglich">
      <bpmn:incoming>Flow_P07_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_P10_Nein</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_P_Merge" name="">
      <bpmn:incoming>Flow_P10_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_P10_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_P11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Patient" name="Prozess beendet">
      <bpmn:incoming>Flow_P11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data -->
    <bpmn:dataObjectReference id="DataObject_Grund" name="Verschiebungsgrund" dataObjectRef="DO_Grund" />
    <bpmn:dataObject id="DO_Grund" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_P01" sourceRef="Start_Patient" targetRef="Task_P_Anmelden" />
    <bpmn:sequenceFlow id="Flow_P02" sourceRef="Task_P_Anmelden" targetRef="Task_P_TermineEinsehen" />
    <bpmn:sequenceFlow id="Flow_P03" sourceRef="Task_P_TermineEinsehen" targetRef="Task_P_TerminAuswaehlen" />
    <bpmn:sequenceFlow id="Flow_P04" sourceRef="Task_P_TerminAuswaehlen" targetRef="Task_P_GrundAngeben" />
    <bpmn:sequenceFlow id="Flow_P05" sourceRef="Task_P_GrundAngeben" targetRef="Task_P_AnfrageAbsenden" />
    <bpmn:sequenceFlow id="Flow_P06" sourceRef="Task_P_AnfrageAbsenden" targetRef="GW_P_Ergebnis" />
    <bpmn:sequenceFlow id="Flow_P07_Ja" name="Ja" sourceRef="GW_P_Ergebnis" targetRef="Task_P_AlternativenErhalten" />
    <bpmn:sequenceFlow id="Flow_P07_Nein" name="Nein" sourceRef="GW_P_Ergebnis" targetRef="Task_P_AbbruchErhalten" />
    <bpmn:sequenceFlow id="Flow_P08" sourceRef="Task_P_AlternativenErhalten" targetRef="Task_P_NeuenTerminWaehlen" />
    <bpmn:sequenceFlow id="Flow_P09" sourceRef="Task_P_NeuenTerminWaehlen" targetRef="Task_P_BestaetigungErhalten" />
    <bpmn:sequenceFlow id="Flow_P10_Ja" sourceRef="Task_P_BestaetigungErhalten" targetRef="GW_P_Merge" />
    <bpmn:sequenceFlow id="Flow_P10_Nein" sourceRef="Task_P_AbbruchErhalten" targetRef="GW_P_Merge" />
    <bpmn:sequenceFlow id="Flow_P11" sourceRef="GW_P_Merge" targetRef="End_Patient" />
  </bpmn:process>

  <!-- ====== SYSTEM PROCESS ====== -->
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:task id="Task_S_AnfrageEmpfangen" name="Verschiebungsanfrage empfangen">
      <bpmn:outgoing>Flow_S01</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_TerminIdentifizieren" name="Bestehenden Termin im Kalender identifizieren">
      <bpmn:incoming>Flow_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S02</bpmn:outgoing>
      <bpmn:property id="Prop_S_Kal" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S1">
        <bpmn:sourceRef>DataStore_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_S_Frist" name="Verschiebung innerhalb der Frist?">
      <bpmn:incoming>Flow_S02</bpmn:incoming>
      <bpmn:outgoing>Flow_S03_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_S03_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Pfad: nicht moeglich -->
    <bpmn:task id="Task_S_AbbruchSenden" name="Hinweis an Patient: Verschiebung nicht moeglich">
      <bpmn:incoming>Flow_S03_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_S_End_Nein</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_System_Abbruch" name="Verschiebung abgelehnt">
      <bpmn:incoming>Flow_S_End_Nein</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Pfad: moeglich -->
    <bpmn:task id="Task_S_AlternativenSuchen" name="Alternative freie Termine suchen">
      <bpmn:incoming>Flow_S03_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S04</bpmn:outgoing>
      <bpmn:property id="Prop_S_Kal2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_S2">
        <bpmn:sourceRef>DataStore_Terminkalender</bpmn:sourceRef>
        <bpmn:targetRef>Prop_S_Kal2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_S_AlternativenAnzeigen" name="Alternative Termine an Patient senden">
      <bpmn:incoming>Flow_S04</bpmn:incoming>
      <bpmn:outgoing>Flow_S05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_NeuenTerminEmpfangen" name="Neuen Terminwunsch empfangen">
      <bpmn:incoming>Flow_S05</bpmn:incoming>
      <bpmn:outgoing>Flow_S06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_AltenTerminStornieren" name="Alten Termin stornieren und Slot freigeben">
      <bpmn:incoming>Flow_S06</bpmn:incoming>
      <bpmn:outgoing>Flow_S07</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_Storno">
        <bpmn:targetRef>DataStore_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_S_Geraete" name="Geraete am alten Termin reserviert?">
      <bpmn:incoming>Flow_S07</bpmn:incoming>
      <bpmn:outgoing>Flow_S08_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_S08_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_S_GeraeteUmbuchen" name="Geraete entbuchen und fuer neuen Termin reservieren">
      <bpmn:incoming>Flow_S08_Ja</bpmn:incoming>
      <bpmn:outgoing>Flow_S09_Ja</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_Geraete">
        <bpmn:targetRef>DataStore_Geraeteverwaltung</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_S_MergeGeraete" name="">
      <bpmn:incoming>Flow_S09_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_S08_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_S10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_S_NeuenTerminBuchen" name="Neuen Termin im Kalender eintragen">
      <bpmn:incoming>Flow_S10</bpmn:incoming>
      <bpmn:outgoing>Flow_S11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_S_Neu">
        <bpmn:targetRef>DataStore_Terminkalender</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_S_BestaetigungSenden" name="Verschiebungsbestaetigung an Patient senden">
      <bpmn:incoming>Flow_S11</bpmn:incoming>
      <bpmn:outgoing>Flow_S12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_S_PraxisBenachrichtigen" name="Praxis ueber Terminaenderung benachrichtigen">
      <bpmn:incoming>Flow_S12</bpmn:incoming>
      <bpmn:outgoing>Flow_S13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_System" name="Verschiebung abgeschlossen">
      <bpmn:incoming>Flow_S13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Stores -->
    <bpmn:dataStoreReference id="DataStore_Terminkalender" name="Terminkalender" />
    <bpmn:dataStoreReference id="DataStore_Geraeteverwaltung" name="Geraeteverwaltung" />

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_S01" sourceRef="Task_S_AnfrageEmpfangen" targetRef="Task_S_TerminIdentifizieren" />
    <bpmn:sequenceFlow id="Flow_S02" sourceRef="Task_S_TerminIdentifizieren" targetRef="GW_S_Frist" />
    <bpmn:sequenceFlow id="Flow_S03_Ja" name="Ja" sourceRef="GW_S_Frist" targetRef="Task_S_AlternativenSuchen" />
    <bpmn:sequenceFlow id="Flow_S03_Nein" name="Nein" sourceRef="GW_S_Frist" targetRef="Task_S_AbbruchSenden" />
    <bpmn:sequenceFlow id="Flow_S_End_Nein" sourceRef="Task_S_AbbruchSenden" targetRef="End_System_Abbruch" />
    <bpmn:sequenceFlow id="Flow_S04" sourceRef="Task_S_AlternativenSuchen" targetRef="Task_S_AlternativenAnzeigen" />
    <bpmn:sequenceFlow id="Flow_S05" sourceRef="Task_S_AlternativenAnzeigen" targetRef="Task_S_NeuenTerminEmpfangen" />
    <bpmn:sequenceFlow id="Flow_S06" sourceRef="Task_S_NeuenTerminEmpfangen" targetRef="Task_S_AltenTerminStornieren" />
    <bpmn:sequenceFlow id="Flow_S07" sourceRef="Task_S_AltenTerminStornieren" targetRef="GW_S_Geraete" />
    <bpmn:sequenceFlow id="Flow_S08_Ja" name="Ja" sourceRef="GW_S_Geraete" targetRef="Task_S_GeraeteUmbuchen" />
    <bpmn:sequenceFlow id="Flow_S08_Nein" name="Nein" sourceRef="GW_S_Geraete" targetRef="GW_S_MergeGeraete" />
    <bpmn:sequenceFlow id="Flow_S09_Ja" sourceRef="Task_S_GeraeteUmbuchen" targetRef="GW_S_MergeGeraete" />
    <bpmn:sequenceFlow id="Flow_S10" sourceRef="GW_S_MergeGeraete" targetRef="Task_S_NeuenTerminBuchen" />
    <bpmn:sequenceFlow id="Flow_S11" sourceRef="Task_S_NeuenTerminBuchen" targetRef="Task_S_BestaetigungSenden" />
    <bpmn:sequenceFlow id="Flow_S12" sourceRef="Task_S_BestaetigungSenden" targetRef="Task_S_PraxisBenachrichtigen" />
    <bpmn:sequenceFlow id="Flow_S13" sourceRef="Task_S_PraxisBenachrichtigen" targetRef="End_System" />
  </bpmn:process>

  <!-- ====== PRAXIS PROCESS ====== -->
  <bpmn:process id="Process_Praxis" isExecutable="false">
    <bpmn:startEvent id="Start_Praxis" name="Aenderungsbenachrichtigung empfangen">
      <bpmn:outgoing>Flow_Pr01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_StartPr" />
    </bpmn:startEvent>

    <bpmn:task id="Task_Pr_AenderungPruefen" name="Terminaenderung pruefen">
      <bpmn:incoming>Flow_Pr01</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Pr_KalenderAktualisieren" name="Praxiskalender aktualisieren">
      <bpmn:incoming>Flow_Pr02</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Pr_RessourcenAnpassen" name="Ressourcenplanung bei Bedarf anpassen">
      <bpmn:incoming>Flow_Pr03</bpmn:incoming>
      <bpmn:outgoing>Flow_Pr04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Praxis" name="Aenderung verarbeitet">
      <bpmn:incoming>Flow_Pr04</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Pr01" sourceRef="Start_Praxis" targetRef="Task_Pr_AenderungPruefen" />
    <bpmn:sequenceFlow id="Flow_Pr02" sourceRef="Task_Pr_AenderungPruefen" targetRef="Task_Pr_KalenderAktualisieren" />
    <bpmn:sequenceFlow id="Flow_Pr03" sourceRef="Task_Pr_KalenderAktualisieren" targetRef="Task_Pr_RessourcenAnpassen" />
    <bpmn:sequenceFlow id="Flow_Pr04" sourceRef="Task_Pr_RessourcenAnpassen" targetRef="End_Praxis" />
  </bpmn:process>

  <!-- ====== DIAGRAM ====== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_04">

      <!-- ===== PATIENT POOL ===== -->
      <bpmndi:BPMNShape id="Shape_Pool_Patient" bpmnElement="Pool_Patient" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1540" height="350" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_Patient" bpmnElement="Start_Patient">
        <dc:Bounds x="232" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="210" y="245" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_Anmelden" bpmnElement="Task_P_Anmelden">
        <dc:Bounds x="310" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_TermineEinsehen" bpmnElement="Task_P_TermineEinsehen">
        <dc:Bounds x="440" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_TerminAuswaehlen" bpmnElement="Task_P_TerminAuswaehlen">
        <dc:Bounds x="570" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_GrundAngeben" bpmnElement="Task_P_GrundAngeben">
        <dc:Bounds x="700" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_AnfrageAbsenden" bpmnElement="Task_P_AnfrageAbsenden">
        <dc:Bounds x="830" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_P_Ergebnis" bpmnElement="GW_P_Ergebnis" isMarkerVisible="true">
        <dc:Bounds x="965" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="942" y="170" width="96" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_P_AlternativenErhalten" bpmnElement="Task_P_AlternativenErhalten">
        <dc:Bounds x="1060" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_NeuenTerminWaehlen" bpmnElement="Task_P_NeuenTerminWaehlen">
        <dc:Bounds x="1190" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_P_BestaetigungErhalten" bpmnElement="Task_P_BestaetigungErhalten">
        <dc:Bounds x="1320" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_P_AbbruchErhalten" bpmnElement="Task_P_AbbruchErhalten">
        <dc:Bounds x="1060" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_GW_P_Merge" bpmnElement="GW_P_Merge" isMarkerVisible="true">
        <dc:Bounds x="1455" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Patient" bpmnElement="End_Patient">
        <dc:Bounds x="1542" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1520" y="245" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Data Object -->
      <bpmndi:BPMNShape id="Shape_DO_Grund" bpmnElement="DataObject_Grund">
        <dc:Bounds x="762" y="90" width="36" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="798" y="100" width="95" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Patient Flows -->
      <bpmndi:BPMNEdge id="Edge_P01" bpmnElement="Flow_P01">
        <di:waypoint x="268" y="220" /><di:waypoint x="310" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P02" bpmnElement="Flow_P02">
        <di:waypoint x="410" y="220" /><di:waypoint x="440" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P03" bpmnElement="Flow_P03">
        <di:waypoint x="540" y="220" /><di:waypoint x="570" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P04" bpmnElement="Flow_P04">
        <di:waypoint x="670" y="220" /><di:waypoint x="700" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P05" bpmnElement="Flow_P05">
        <di:waypoint x="800" y="220" /><di:waypoint x="830" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P06" bpmnElement="Flow_P06">
        <di:waypoint x="930" y="220" /><di:waypoint x="965" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P07_Ja" bpmnElement="Flow_P07_Ja">
        <di:waypoint x="990" y="195" /><di:waypoint x="990" y="150" /><di:waypoint x="1060" y="150" />
        <bpmndi:BPMNLabel><dc:Bounds x="995" y="133" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P07_Nein" bpmnElement="Flow_P07_Nein">
        <di:waypoint x="990" y="245" /><di:waypoint x="990" y="330" /><di:waypoint x="1060" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="995" y="313" width="25" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
